/orcid.org/0000-0003-4289-4922", "@type": "Person"}, {"name": "Frederik Coppens", "familyName": "Frederik Coppens", "@id": "https://orcid.org/0000-0001-6565-5145", "@type": "Person"}, {"name": "Carole Goble", "familyName": "Carole Goble", "@id": "https://orcid.org/0000-0003-1219-2137", "@type": "Person"}, {"name": "Jos\u00e9 Mar\u00eda Fern\u00e1ndez", "familyName": "Jos\u00e9 Mar\u00eda Fern\u00e1ndez", "@id": "https://orcid.org/0000-0002-4806-5140", "@type": "Person"}, {"name": "Kyle Chard", "familyName": "Kyle Chard", "@id": "https://orcid.org/0000-0002-7370-4805", "@type": "Person"}, {"name": "Jose Manuel Gomez-Perez", "familyName": "Jose Manuel Gomez-Perez", "@id": "https://orcid.org/0000-0002-5491-6431", "@type": "Person"}, {"name": "Michael R Crusoe", "familyName": "Michael R Crusoe", "@id": "https://orcid.org/0000-0002-2961-9670", "@type": "Person"}, {"name": "Ignacio Eguinoa", "familyName": "Ignacio Eguinoa", "@id": "https://orcid.org/0000-0002-6190-122X", "@type": "Person"}, {"name": "Nick Juty", "familyName": "Nick Juty", "@id": "https://orcid.org/0000-0002-2036-8350", "@type": "Person"}, {"name": "Kristi Holmes", "familyName": "Kristi Holmes", "@id": "https://orcid.org/0000-0001-8420-5254", "@type": "Person"}, {"name": "Jason A. Clark", "familyName": "Jason A. Clark", "@id": "https://orcid.org/0000-0002-3588-6257", "@type": "Person"}, {"name": "Salvador Capella-Gutierrez", "familyName": "Salvador Capella-Gutierrez", "@id": "https://orcid.org/0000-0002-0309-604X", "@type": "Person"}, {"name": "Alasdair J. G. Gray", "familyName": "Alasdair J. G. Gray", "@id": "https://orcid.org/0000-0002-5711-4872", "@type": "Person"}, {"name": "Stuart Owen", "familyName": "Stuart Owen", "@id": "https://orcid.org/0000-0003-2130-0865", "@type": "Person"}, {"name": "Alan R. Williams", "familyName": "Alan R. Williams", "@id": "https://orcid.org/0000-0003-3156-2105", "@type": "Person"}, {"name": "Giacomo Tartari", "familyName": "Giacomo Tartari", "@id": "https://orcid.org/0000-0003-1130-2154", "@type": "Person"}, {"name": "Finn Bacall", "familyName": "Finn Bacall", "@id": "https://orcid.org/0000-0002-0048-3300", "@type": "Person"}, {"name": "Thomas Thelen", "familyName": "Thomas Thelen", "@id": "https://orcid.org/0000-0002-1756-2128", "@type": "Person"}], "editor": [{"name": "Eoghan \u00d3 Carrag\u00e1in", "familyName": "Eoghan \u00d3 Carrag\u00e1in", "@id": "https://orcid.org/0000-0001-8131-2150", "@type": "Person"}, {"name": "Peter Sefton", "familyName": "Peter Sefton", "@id": "https://orcid.org/0000-0002-3545-944X", "@type": "Person"}, {"name": "Stian Soiland-Reyes", "familyName": "Stian Soiland-Reyes", "@id": "https://orcid.org/0000-0001-9842-9718", "@type": "Person"}], "publisher": {"@type": "Organization", "name": "Zenodo"}, "keywords": "research object, data packaging, metadata, schema.org, JSON-LD, linked data", "dateCreated": "2019-11-14T18:44:35.279690+00:00", "dateModified": "2024-07-22T16:22:08.593466+00:00", "datePublished": "2019-11-15", "inLanguage": {"alternateName": "eng", "@type": "Language", "name": "English"}, "contentSize": "719.35 KB", "size": "719.35 KB", "version": "1.0.0", "license": "https://www.apache.org/licenses/LICENSE-2.0", "description": "<p><strong>Web-version:</strong> <a href=\"https://w3id.org/ro/crate/1.0\">https://w3id.org/ro/crate/1.0</a></p>\n\n<p>This document specifies a method, known as <em>RO-Crate</em> (Research Object Crate), of organizing file-based data with associated metadata, using linked data principles, in both human and machine readable formats, with the ability to include additional domain-specific metadata.</p>\n\n<p>The core of RO-Crate is a JSON-LD file, the <em>RO-Crate Metadata File</em>, named <code>ro-crate-metadata.jsonld</code>. This file contains structured metadata about the dataset as a whole (the <em>Root Data Entity</em>) and, optionally, about some or all of its files. This provides a simple way to, for example, assert the authors (e.g. people, organizations) of the RO-Crate or one its files, or to capture more complex provenance for files, such as how they were created using software and equipment.</p>\n\n<p>While providing the formal specification for RO-Crate, this document also aims to be a practical guide for software authors to create tools for generating and consuming research data packages, with explanation by examples.</p>", "sameAs": [{"@type": "CreativeWork", "@id": "https://github.com/ResearchObject/ro-crate/releases/tag/1.0.0"}], "citation": [{"@type": "CreativeWork", "@id": "https://doi.org/10.17487/RFC2119"}, {"@type": "CreativeWork", "@id": "http://researchobject.org/"}, {"@type": "CreativeWork", "@id": "https://schema.org/"}, {"@type": "CreativeWork", "@id": "http://www.w3.org/TR/2014/REC-json-ld-20140116/"}, {"@type": "CreativeWork", "@id": "https://doi.org/10.17487/RFC7159"}, {"@type": "CreativeWork", "@id": "https://doi.org/10.17487/RFC3986"}, {"@type": "CreativeWork", "@id": "https://www.w3.org/TR/html52/"}, {"@type": "CreativeWork", "@id": "https://doi.org/10.25490/a97f-egyk"}, {"@type": "CreativeWork", "@id": "https://doi.org/10.17487/RFC8493"}, {"@type": "CreativeWork", "@id": "https://ocfl.io/"}, {"@type": "CreativeWork", "@id": "https://w3id.org/ro/2016-01-28/"}, {"@type": "CreativeWork", "@id": "https://github.com/duraspace/pcdm/wiki"}, {"@type": "CreativeWork", "@id": "https://orcid.org/"}, {"@type": "CreativeWork", "@id": "https://ror.org/"}, {"@type": "CreativeWork", "@id": "https://www.nationalarchives.gov.uk/PRONOM/Default.aspx"}, {"@type": "CreativeWork", "@id": "https://en.wikipedia.org/wiki/Exif"}, {"@type": "CreativeWork", "@id": "https://en.wikipedia.org/wiki/BagIt"}, {"@type": "CreativeWork", "@id": "https://www.geonames.org/"}, {"@type": "CreativeWork", "@id": "https://omeka.org/"}, {"@type": "CreativeWork", "@id": "http://purl.org/ontology/bibo/interviewee"}, {"@type": "CreativeWork", "@id": "http://neologism.ecs.soton.ac.uk/bibo.html#interviewee"}, {"@type": "CreativeWork", "@id": "https://doi.org/10.25490/a97f-egyk"}], "url": "https://zenodo.org/records/3541888"}