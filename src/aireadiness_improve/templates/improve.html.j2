<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI-Ready Improvements{% if crate %} — {{ crate_label | default("") | replace("/ro-crate-metadata.json", "") }}{% endif %}</title>
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --line: #d9d9d9; --bg: #fafaf8;
    --card: #ffffff; --accent: #b45309; --ok: #15803d; --bad: #b91c1c;
    --unknown: #6b6b6b; --gate: #7c2d12; --edit: #1d4ed8;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 14px/1.45 "Source Sans 3", "Segoe UI", system-ui, sans-serif; }
  .mono { font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace; font-size: 0.86em; }
  a { color: var(--accent); }
  header { border-bottom: 2px solid var(--ink); padding: 16px 0 12px; background: var(--card); }
  footer { border-top: 1px solid var(--line); margin-top: 28px; padding: 10px 0 24px;
           color: var(--muted); font-size: 0.8rem; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  h1 { font-size: 1.25rem; margin: 0 0 2px; }
  h2 { font-size: 1.05rem; border-bottom: 1px solid var(--line); padding-bottom: 4px; margin: 26px 0 10px;
       display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap;
       scroll-margin-top: 58px; }
  .meta { color: var(--muted); font-size: 0.85rem; }
  .badge { display: inline-block; border: 1px solid var(--gate); color: var(--gate); border-radius: 2px;
           font-size: 0.68rem; padding: 0 5px; margin-left: 8px; vertical-align: 2px;
           text-transform: uppercase; letter-spacing: 0.05em; }
  .badge.sw { border-color: var(--muted); color: var(--muted); }
  nav.toc { margin: 14px 0; font-size: 0.88rem; }
  nav.toc a { margin-right: 12px; white-space: nowrap; }

  .loadbox { background: var(--card); border: 1px dashed var(--line); border-radius: 2px; padding: 10px 12px;
             margin: 12px 0; font-size: 0.88rem; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .loadbox.drag { border-color: var(--accent); background: #fdf6ec; }
  .loadbox label { cursor: pointer; color: var(--accent); }
  .loadbox input[type=file] { display: none; }
  .intro { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 8px 12px; margin: 12px 0; font-size: 0.88rem; }
  .intro ul { margin: 4px 0 0; padding-left: 18px; }

  .criterion { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 10px 14px 8px; margin: 0 0 10px;
               scroll-margin-top: 58px; }
  .criterion h3 { margin: 0; font-size: 0.98rem; display: inline; }
  .practice { color: var(--muted); font-style: italic; margin: 2px 0 6px; font-size: 0.85rem; }
  details.rules { margin: 0 0 6px; font-size: 0.85rem; }
  details.rules summary { cursor: pointer; color: var(--muted); }
  .scores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 6px 0 8px; }
  .scores > div { border: 1px solid var(--line); border-radius: 2px; padding: 4px 8px; font-size: 0.8rem; line-height: 1.35; color: #333; background: #fcfcfa; }
  .scores .n { font-weight: 700; margin-right: 6px; font-size: 0.9rem; }
  .rubric-note { color: var(--muted); font-size: 0.78rem; margin: -2px 0 6px; }
  .oos { font-size: 0.8rem; color: var(--gate); background: #fdf6ec; border: 1px dashed var(--line); padding: 4px 8px; margin: 4px 0 8px; border-radius: 2px; }

  .status { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 6px; margin-top: 4px; font-size: 0.82rem; }
  .status .est { flex: 1 1 320px; }
  .status ul { margin: 2px 0 0; padding-left: 18px; color: #555; }
  .chip { display: inline-block; min-width: 22px; text-align: center; border: 1px dashed var(--line); border-radius: 2px;
          font-size: 0.72rem; line-height: 1.5; text-decoration: none; color: var(--muted); padding: 0 3px;
          font-family: "JetBrains Mono", Consolas, monospace; }
  .chip.s2 { border: 1px solid var(--ok); color: var(--ok); background: #edf7ef; font-weight: 700; }
  .chip.s1 { border: 1px solid var(--accent); color: var(--accent); background: #fdf3e7; font-weight: 700; }
  .chip.s0 { border: 1px solid var(--bad); color: var(--bad); background: #fbeeee; font-weight: 700; }
  .chip.sq { border: 1px solid var(--unknown); color: var(--unknown); background: #f1f1ef; font-weight: 700; }
  .yes { color: var(--ok); font-weight: 600; }
  .no { color: var(--bad); font-weight: 600; }
  .dim { color: var(--muted); }
  .est-badge { display: inline-block; border: 1px solid var(--accent); color: var(--accent); border-radius: 2px; font-size: 0.68rem; padding: 0 5px; margin-right: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
  .prior { color: var(--muted); font-size: 0.78rem; margin-top: 2px; }

  .fields { margin-top: 8px; }
  .field { display: grid; grid-template-columns: 250px 1fr; gap: 4px 14px; padding: 7px 0; border-top: 1px dotted #ececea; font-size: 0.86rem; }
  .field .label { font-weight: 600; }
  .field .label .prop { display: block; font-weight: 400; color: var(--muted); }
  .field .ctl input[type=text], .field .ctl textarea, .field .ctl select {
    width: 100%; border: 1px solid var(--line); border-radius: 2px; padding: 4px 7px; font: inherit; font-size: 0.86rem; background: var(--card); }
  .field .ctl textarea { min-height: 58px; resize: vertical; }
  .field .ctl textarea.list { min-height: 46px; font-family: "JetBrains Mono", Consolas, monospace; font-size: 0.8rem; }
  .field.edited .ctl input, .field.edited .ctl textarea, .field.edited .ctl select { border-color: var(--edit); box-shadow: inset 2px 0 0 var(--edit); }
  .field.filled .label::before { content: "✓ "; color: var(--ok); }
  .field.empty .label::before { content: "○ "; color: var(--muted); }
  .help { color: var(--muted); font-size: 0.78rem; margin-top: 2px; }
  .state { font-size: 0.76rem; color: var(--muted); margin-top: 2px; }
  .state .revert { color: var(--edit); cursor: pointer; margin-left: 6px; }
  .state .warn { color: var(--gate); }
  .terms .term-row { display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 4px 6px; align-items: center; margin-bottom: 4px; }
  .terms .term-row input { width: 100%; border: 1px solid var(--line); border-radius: 2px; padding: 3px 6px; font: inherit; font-size: 0.82rem; }
  .terms .term-row .t-iri { font-family: "JetBrains Mono", Consolas, monospace; font-size: 0.78rem; }
  .terms .t-find { font-size: 0.78rem; }
  .terms .t-del { padding: 0 7px; line-height: 1.4; }
  .terms .t-badge { grid-column: 1 / -1; font-size: 0.74rem; color: var(--muted); }
  .terms .t-badge.yes { color: var(--ok); }
  .terms .t-badge.warn { color: var(--gate); }
  .terms .term-tools { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .terms .term-tools select { border: 1px solid var(--line); border-radius: 2px; padding: 2px 6px; font: inherit; font-size: 0.8rem; background: var(--card); max-width: 320px; }
  .terms .term-tools .help { margin: 0; font-family: "JetBrains Mono", Consolas, monospace; font-size: 0.72rem; }
  .related { font-size: 0.78rem; color: var(--muted); margin-top: 6px; }
  .related a { margin-right: 8px; }
  .dstoggle { font-size: 0.82rem; margin: 6px 0 2px; }

  table.sw { border-collapse: collapse; width: 100%; font-size: 0.8rem; margin-top: 6px; }
  table.sw th { text-align: left; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);
                border-bottom: 1px solid var(--line); padding: 3px 6px 3px 0; vertical-align: bottom; }
  table.sw td { padding: 3px 6px 3px 0; border-bottom: 1px dotted #ececea; vertical-align: top; }
  table.sw input[type=text] { width: 100%; min-width: 120px; border: 1px solid var(--line); border-radius: 2px; padding: 2px 5px; font: inherit; font-size: 0.8rem; }
  table.sw input.edited { border-color: var(--edit); box-shadow: inset 2px 0 0 var(--edit); }
  table.sw .applyall { display: block; font-weight: 400; text-transform: none; letter-spacing: 0; }
  table.sw .applyall input { width: 100%; min-width: 100px; font-size: 0.74rem; padding: 1px 4px; }
  table.sw .applyall button { font-size: 0.7rem; padding: 0 5px; }
  .swwrap { overflow-x: auto; }

  .summarybar { position: sticky; top: 0; z-index: 10; background: var(--card); border-bottom: 1px solid var(--line); padding: 7px 0; font-size: 0.86rem; }
  .summarybar .wrap { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pct-bar { display: inline-block; width: 120px; height: 9px; background: #eee; border-radius: 2px; margin: 0 6px; vertical-align: 1px; }
  .pct-bar span { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
  .pct-bar span.base { background: #c9c9c5; position: relative; }
  .pct-wrap { position: relative; display: inline-block; width: 120px; height: 9px; background: #eee; border-radius: 2px; margin: 0 6px; vertical-align: 1px; }
  .pct-wrap span { position: absolute; left: 0; top: 0; height: 100%; border-radius: 2px; }
  .pct-wrap .base { background: #c9c9c5; }
  .pct-wrap .cur { background: var(--accent); }
  .score { font-weight: 700; }
  .delta { color: var(--ok); font-weight: 700; }
  details.secmenu > summary { cursor: pointer; list-style: none; border: 1px solid var(--line); border-radius: 2px; padding: 2px 10px; font-size: 0.82rem; user-select: none; }
  details.secmenu > summary::-webkit-details-marker { display: none; }
  details.secmenu > summary::after { content: " ▾"; color: var(--muted); }
  .secpanel { position: absolute; top: calc(100% + 1px); z-index: 30; left: calc((100% - min(100%, 1080px)) / 2 + 24px);
              background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 8px 12px 10px;
              min-width: min(640px, calc(100vw - 48px)); max-width: calc(100vw - 48px); max-height: 70vh; overflow: auto; }
  .secrow { display: flex; align-items: baseline; gap: 10px; padding: 4px 0; border-top: 1px dotted #ececea; flex-wrap: wrap; }
  .secrow:first-child { border-top: 0; }
  .secrow .sec-title { flex: 0 0 210px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.85rem; }
  .secrow .sec-stat { flex: 1; color: var(--muted); font-size: 0.78rem; white-space: nowrap; }
  .chips { display: inline-flex; gap: 4px; }
  .chip-key { margin-top: 6px; color: var(--muted); font-size: 0.75rem; }
  .btn { background: none; border: 1px solid var(--line); border-radius: 2px; padding: 3px 10px; font: inherit; font-size: 0.82rem; cursor: pointer; color: var(--ink); }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn.primary:hover { background: #9a4607; color: #fff; }
  .btn.danger:hover { border-color: var(--bad); color: var(--bad); }
  .axis-score { font-size: 0.75rem; font-weight: 400; color: var(--muted); border: 1px solid var(--line); border-radius: 2px; padding: 1px 8px; background: var(--card); white-space: nowrap; }
  .axis-score b { color: var(--ink); }

  .exportbar { position: sticky; bottom: 0; background: var(--card); border-top: 1px solid var(--line); padding: 8px 0; margin-top: 28px; z-index: 10; }
  .exportbar .wrap { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .exportbar .msg { color: var(--muted); font-size: 0.82rem; }
  .valid { font-size: 0.82rem; }
  .valid.ok { color: var(--ok); }
  .valid.bad { color: var(--bad); }
  #validation { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 8px 12px; margin: 12px 0; font-size: 0.85rem; }
  #validation ul { margin: 4px 0 0; padding-left: 18px; }
  #validation button { margin-left: 8px; }
  #changes { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 8px 12px; margin: 12px 0; font-size: 0.85rem; }
  #changes ul { margin: 4px 0 0; padding-left: 18px; }
  .hidden { display: none !important; }
  .viewtoggle { display: inline-flex; border: 1px solid var(--line); border-radius: 2px; overflow: hidden; }
  .viewtoggle button { background: none; border: 0; padding: 3px 10px; font: inherit; font-size: 0.82rem; cursor: pointer; color: var(--muted); }
  .viewtoggle button.on { background: var(--accent); color: #fff; }
  .filterbox { font-size: 0.82rem; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .progress { font-size: 0.82rem; color: var(--muted); white-space: nowrap; }
  .progress b { color: var(--ink); }
  .group { margin: 22px 0 6px; scroll-margin-top: 58px; }
  .group h2 { margin-bottom: 2px; }
  .group .gdesc { color: var(--muted); font-size: 0.85rem; margin: 0 0 8px; }
  .group .gcount { font-size: 0.75rem; font-weight: 400; color: var(--muted); border: 1px solid var(--line); border-radius: 2px; padding: 1px 8px; background: var(--card); }
  .glist { background: var(--card); border: 1px solid var(--line); border-radius: 2px; padding: 2px 14px 6px; }
  .glist .field:first-child { border-top: 0; }
  .glist .field.field-sw { display: block; }
  .why { font-size: 0.76rem; color: var(--muted); margin-top: 3px; }
  .why a { color: var(--muted); text-decoration: none; border-bottom: 1px dotted var(--line); margin-right: 6px; }
  .why a:hover { color: var(--accent); }
  .why .chip { margin-right: 3px; }
  .empty-note { color: var(--muted); font-size: 0.85rem; padding: 8px 0; }
  .done-banner { background: #edf7ef; border: 1px solid var(--ok); color: var(--ok); border-radius: 2px; padding: 6px 12px; margin: 12px 0; font-size: 0.88rem; }
  @media (max-width: 720px) { .field { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>AI-Ready Improvements</h1>
    <div id="crate-line" style="margin-top:6px"><span class="dim">No crate loaded — drop a ro-crate-metadata.json below.</span></div>
  </div>
</header>

<div class="summarybar">
  <div class="wrap">
    <span title="Mechanical rubric estimate (aireadiness_evidence estimate_ rules, no network)">Rubric est.
      <span class="pct-wrap"><span class="base" id="est-base"></span><span class="cur" id="est-fill"></span></span>
      <span class="score" id="est-score">–</span><span class="delta" id="est-delta"></span></span>
    <span class="dim" id="gate-line"></span>
    <span class="viewtoggle" role="group" aria-label="View">
      <button type="button" id="view-checklist" class="on">Checklist</button>
      <button type="button" id="view-criteria">By criterion</button>
    </span>
    <label class="filterbox"><input type="checkbox" id="hide-filled"> hide filled</label>
    <span class="progress" id="field-progress"></span>
    <details class="secmenu" id="secmenu">
      <summary>By section</summary>
      <div class="secpanel" id="secpanel"></div>
    </details>
    <button class="btn" id="next-empty" type="button">Next empty ↓</button>
    <button class="btn primary" id="download-top" type="button">Download crate</button>
  </div>
</div>

<div class="wrap">

  <div class="loadbox" id="loadbox">
    <span><label>📂 Load ro-crate-metadata.json <input type="file" id="file-crate" accept=".json,application/json"></label> (or drop it anywhere on this box)</span>
    <span class="dim">·</span>
    <span><label>Load a prior score <input type="file" id="file-score" accept=".json,application/json"></label> <span class="dim">aggregated_score.json</span></span>
  </div>

  <div class="intro">
    <strong>How this works.</strong> The <em>checklist</em> lists every metadata field the AI-Ready graders read,
    easiest first. Fill in what you know, skip the rest, tick <em>hide filled</em> to see only what is left, and download the
    improved <span class="mono">ro-crate-metadata.json</span> whenever you like — every edit is validated against the
    fairscape_models schema{% if schemas %} (fairscape-models {{ schemas.version }}){% endif %} first.
    <em>By criterion</em> shows the same fields grouped under the 28 rubric criteria with the scoring rules and evidence.
  </div>

  <div id="validation" class="hidden"></div>

  <div id="checklist">
    <div id="done-banner" class="done-banner hidden">Every field is filled — switch to <em>By criterion</em> to see what the remaining gaps need, or download the crate.</div>
  </div>

  <nav class="toc hidden" id="toc"></nav>

  <div id="sections" class="hidden"></div>

  <div id="changes" class="hidden"></div>

  <div class="exportbar">
    <div class="wrap">
      <button class="btn primary" id="download" type="button">Download ro-crate-metadata.json</button>
      <button class="btn" id="copy" type="button">Copy JSON</button>
      <button class="btn" id="download-patch" type="button">Download edits only</button>
      <button class="btn danger" id="reset" type="button">Discard all edits</button>
      <span class="valid" id="valid-line"></span>
      <span class="msg" id="export-msg"></span>
    </div>
  </div>
</div>

<footer>
  <div class="wrap">
    {{ rubric_title }} · generated {{ generated }}{% if schemas %} · fairscape-models {{ schemas.version }}{% endif %}
    <span id="footer-prior"></span>
  </div>
</footer>

<script type="application/json" id="data-sections">{{ sections | embed_json }}</script>
<script type="application/json" id="data-fields">{{ fields | embed_json }}</script>
<script type="application/json" id="data-schemas">{{ schemas | embed_json }}</script>
<script type="application/json" id="data-crate">{{ (crate if crate else none) | embed_json }}</script>
<script type="application/json" id="data-prior">{{ prior | embed_json }}</script>
<script type="application/json" id="data-label">{{ crate_label | embed_json }}</script>
<script type="application/json" id="data-effort">{{ effort_labels | embed_json }}</script>

<script>
{{ core_js | safe }}
</script>

<script>
(function () {
  'use strict';
  var I = window.IMPROVE;
  var SECTIONS = JSON.parse(document.getElementById('data-sections').textContent);
  var FIELDS = JSON.parse(document.getElementById('data-fields').textContent);
  var SCHEMAS = JSON.parse(document.getElementById('data-schemas').textContent) || {};
  var EMBEDDED = JSON.parse(document.getElementById('data-crate').textContent);
  var PRIOR = JSON.parse(document.getElementById('data-prior').textContent) || {};
  var LABEL = JSON.parse(document.getElementById('data-label').textContent) || '';
  var EFFORT_LABELS = JSON.parse(document.getElementById('data-effort').textContent) || {};
  var FIELD_BY_PROP = {};
  FIELDS.forEach(function (f) { FIELD_BY_PROP[f.entity + ':' + f.prop] = f; });
  var CRITERIA = {};
  SECTIONS.forEach(function (s) { s.criteria.forEach(function (c) { CRITERIA[c.id] = c; }); });

  var state = { orig: null, crate: null, edits: { root: {}, software: {} }, hasDatasheet: false, prior: PRIOR, base: null };

  function $(sel, el) { return (el || document).querySelector(sel); }
  function el(tag, attrs, children) {
    var e = document.createElement(tag);
    if (attrs) for (var k in attrs) {
      if (k === 'text') e.textContent = attrs[k];
      else if (k === 'html') e.innerHTML = attrs[k];
      else if (k === 'class') e.className = attrs[k];
      else e.setAttribute(k, attrs[k]);
    }
    (children || []).forEach(function (c) { if (c) e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c); });
    return e;
  }
  function anchorId(cid) { return 'c' + cid.replace('.', '-'); }
  function storageKey() { return 'improve:' + (state.orig ? String(I.findRoot(state.orig['@graph']).root['@id']) : 'none'); }

  // ------------------------------------------------ value <-> input
  function toInput(field, v) {
    if (v === undefined || v === null) return '';
    switch (field.type) {
      case 'list': return I.asList(v).map(I.text).join('\n');
      case 'idlist': return I.idsOf(v).join('\n');
      case 'bool': return v === true ? 'true' : v === false ? 'false' : '';
      default:
        if (Array.isArray(v)) return v.map(I.text).join('\n');
        return I.text(v);
    }
  }
  function fromInput(field, raw, orig) {
    var s = String(raw);
    var lines = s.split('\n').map(function (x) { return x.trim(); }).filter(Boolean);
    switch (field.type) {
      case 'list': return lines.length ? lines : null;
      case 'idlist': return lines.length ? lines.map(function (l) { return { '@id': l }; }) : null;
      case 'bool': return s === 'true' ? true : s === 'false' ? false : null;
      case 'select': return s.trim() ? s.trim() : null;
      default:
        if (Array.isArray(orig)) return lines.length ? lines : null;
        return s.trim() ? s.trim() : null;
    }
  }
  function sameValue(a, b) { return JSON.stringify(a === undefined ? null : a) === JSON.stringify(b === undefined ? null : b); }

  // ------------------------------------------------ crate loading
  function loadDoc(doc, label) {
    var crate;
    try { crate = I.loadCrate(doc); }
    catch (err) { alert('Could not load crate: ' + err.message); return; }
    state.orig = doc;
    state.edits = { root: {}, software: {} };
    state.hasDatasheet = false;
    try {
      var saved = JSON.parse(localStorage.getItem('improve:' + String(crate.root['@id'])) || 'null');
      if (saved && saved.edits) { state.edits = saved.edits; state.hasDatasheet = !!saved.hasDatasheet; }
    } catch (e) { /* storage unavailable */ }
    state.crate = I.loadCrate(I.applyEdits(doc, {}));
    state.base = { est: I.aggregate(I.estimateAll(crate, { hasDatasheet: state.hasDatasheet })) };
    renderHeader(label);
    renderAll();
  }
  function currentDoc() { return I.applyEdits(state.orig, state.edits); }

  function renderHeader(label) {
    var root = state.crate.root;
    $('#crate-line').innerHTML = '';
    $('#crate-line').appendChild(el('strong', { text: root.name || '(unnamed crate)' }));
    $('#crate-line').appendChild(el('span', { class: 'mono', text: ' ' + root['@id'] }));
    $('#crate-line').appendChild(el('span', { class: 'meta', text: (root.identifier ? ' · ' + root.identifier : '') + (root.datePublished ? ' · published ' + root.datePublished : '') + (label ? ' · ' + label : '') }));
    var st = state.crate.stats;
