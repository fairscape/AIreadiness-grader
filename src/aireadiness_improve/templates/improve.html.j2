    if (FIELDS.some(function (f) { return f.entity === 'software' && f.criteria[0] === c.id; })) {
      fieldsWrap.appendChild(el('div', { class: 'swwrap', 'data-swtable': c.id }));
    }
    card.appendChild(fieldsWrap);
    var related = FIELDS.filter(function (f) { return f.criteria.indexOf(c.id) > 0; });
    if (related.length) {
