    if (c.gate_min) head.appendChild(el('span', { class: 'badge', text: 'Gate: must score ' + (c.gate_min === 2 ? '2' : 'above 0') }));
    else if (c.gating) head.appendChild(el('span', { class: 'badge', text: 'Gating' }));
