          sw.forEach(function (e) { setSoftwareEdit(String(e['@id']), f, ai.value, true); });
          buildSoftwareTables(); onChange();
        });
        all.appendChild(ai); all.appendChild(ab); th.appendChild(all);
        th.title = f.help;
        thead.appendChild(th);
      });
      table.appendChild(thead);
      var origById = {};
      state.orig['@graph'].forEach(function (e) { origById[String(e['@id'])] = e; });
      sw.forEach(function (e) {
        var id = String(e['@id']);
        var tr = el('tr', {}, [el('td', {}, [el('strong', { text: e.name || id }), el('div', { class: 'help mono', text: id })])]);
        myCols.forEach(function (f) {
          var origV = origById[id] ? origById[id][f.prop] : undefined;
          var edit = (state.edits.software[id] || {})[f.prop];
          var val = edit !== undefined ? (edit === null ? '' : toInput(f, edit)) : toInput(f, origV);
          var inp = el('input', { type: 'text', value: val, placeholder: f.placeholder || '' });
          if (edit !== undefined) inp.className = 'edited';
          inp.addEventListener('input', function () { setSoftwareEdit(id, f, inp.value, false); inp.className = (state.edits.software[id] || {})[f.prop] !== undefined ? 'edited' : ''; onChange(); });
          tr.appendChild(el('td', {}, [inp]));
        });
        table.appendChild(tr);
      });
      wrap.appendChild(table);
      if (otherCols.length) wrap.appendChild(el('div', { class: 'related', text: 'More software columns under ' + otherCols.map(function (f) { return f.criteria[0]; }).filter(function (v, i, a) { return a.indexOf(v) === i; }).join(', ') }));
    });
  }
  function setSoftwareEdit(id, f, raw, onlyIfEmpty) {
    var origE = null;
    state.orig['@graph'].some(function (e) { if (String(e['@id']) === id) { origE = e; return true; } return false; });
    var origV = origE ? origE[f.prop] : undefined;
    var cur = state.edits.software[id] || {};
    if (onlyIfEmpty && ((cur[f.prop] !== undefined && cur[f.prop] !== null) || (cur[f.prop] === undefined && I.nonblank(origV)))) return;
    var v = fromInput(f, raw, origV);
    if (v === null && origV === undefined) delete cur[f.prop];
    else if (sameValue(v, origV)) delete cur[f.prop];
    else cur[f.prop] = v;
    if (Object.keys(cur).length) state.edits.software[id] = cur; else delete state.edits.software[id];
  }

  // ------------------------------------------------ rendering values & scores
  function renderFields() {
    var root = I.findRoot(state.orig['@graph']).root;
    document.querySelectorAll('.field[data-prop]').forEach(function (row) {
      var prop = row.getAttribute('data-prop'), f = FIELD_BY_PROP['root:' + prop];
      var origV = root[prop], edit = state.edits.root[prop];
      if (f.type === 'terms') {
        if (!row.contains(document.activeElement)) row._terms.render(edit !== undefined ? edit : origV);
      } else {
        var input = row.querySelector('input, textarea, select');
        var shown = edit !== undefined ? (edit === null ? '' : toInput(f, edit)) : toInput(f, origV);
        if (document.activeElement !== input) input.value = shown;
      }
      var filled = edit !== undefined ? edit !== null : I.nonblank(origV);
      row.classList.toggle('filled', filled); row.classList.toggle('empty', !filled);
      row.classList.toggle('edited', edit !== undefined);
      var st = row.querySelector('.state'); st.innerHTML = '';
      if (edit !== undefined) {
        st.appendChild(document.createTextNode(edit === null ? 'cleared — the property will be removed on download' : 'edited (was ' + (I.nonblank(origV) ? JSON.stringify(origV).slice(0, 80) : 'empty') + ')'));
        var rv = el('span', { class: 'revert', text: 'revert' });
        rv.addEventListener('click', function () { delete state.edits.root[prop]; onChange(); });
        st.appendChild(rv);
      } else if (I.nonblank(origV)) {
        st.appendChild(document.createTextNode('from the crate'));
        if (origV && typeof origV === 'object' && !Array.isArray(origV)) st.appendChild(el('span', { class: 'warn', text: ' — structured value (' + JSON.stringify(origV).slice(0, 60) + '); editing replaces it with plain text' }));
        else if (Array.isArray(origV) && f.type !== 'list' && f.type !== 'idlist' && f.type !== 'terms') st.appendChild(el('span', { class: 'warn', text: ' — stored as a list; one item per line' }));
      } else st.appendChild(document.createTextNode('not set'));
    });
    var ds = $('#has-datasheet'); if (ds) ds.checked = state.hasDatasheet;
  }

  function chip(score) {
    var cls = score === null ? 'sq' : 's' + score;
    return el('span', { class: 'chip ' + cls, text: score === null ? '?' : String(score) });
  }
  function priorFor(cid) {
