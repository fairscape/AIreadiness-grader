  function buildField(f) {
    var row = el('div', { class: 'field empty', 'data-prop': f.prop, 'data-effort': f.effort, 'data-home': f.criteria[0] });
    var why = el('span', { class: 'why' }, [document.createTextNode('for ')].concat(f.criteria.map(function (cid) {
      var c = CRITERIA[cid];
      return el('a', { href: '#' + anchorId(cid), 'data-why': cid, title: c ? c.practice : '' }, [
        el('span', { class: 'chip', 'data-whychip': cid, text: '·' }), ' ' + cid + ' ' + (c ? c.name : '')
      ]);
    })));
    var label = el('div', { class: 'label' }, [
      f.label,
      el('span', { class: 'prop mono', text: f.prop }),
      why
    ]);
    var ctl = el('div', { class: 'ctl' });
    var input;
    if (f.type === 'textarea') input = el('textarea', { placeholder: f.placeholder || '' });
    else if (f.type === 'list' || f.type === 'idlist') input = el('textarea', { class: 'list', placeholder: f.placeholder || 'one per line' });
    else if (f.type === 'bool') {
      input = el('select', {}, [el('option', { value: '', text: '— not set —' }), el('option', { value: 'true', text: 'true' }), el('option', { value: 'false', text: 'false' })]);
    } else if (f.type === 'select') {
      input = el('select', {}, [el('option', { value: '', text: '— not set —' })].concat(f.options.map(function (o) { return el('option', { value: o[0], text: o[1] }); })));
    } else if (f.type === 'terms') {
      input = null;
      ctl.appendChild(buildTermsEditor(f, row));
    } else {
      input = el('input', { type: 'text', placeholder: f.placeholder || '' });
      if (f.options && f.options.length) {
        var dl = el('datalist', { id: 'dl-' + f.prop.replace(/[^a-z0-9]/gi, '_') }, f.options.map(function (o) { return el('option', { value: o }); }));
        ctl.appendChild(dl); input.setAttribute('list', dl.id);
      }
    }
    if (input) {
      if ((f.type === 'list') && f.options && f.options.length) {
        var dl2 = el('div', { class: 'help', text: 'Suggested: ' + f.options.join(' · ') });
        ctl.appendChild(input); ctl.appendChild(dl2);
      } else ctl.appendChild(input);
      input.addEventListener('input', function () { setRootEdit(f, input.value); });
      input.addEventListener('change', function () { setRootEdit(f, input.value); });
    }
    ctl.appendChild(el('div', { class: 'help', text: f.help }));
    ctl.appendChild(el('div', { class: 'state' }));
    row.appendChild(label); row.appendChild(ctl);
    return row;
  }

  function setRootEdit(f, raw) {
    if (!state.orig) return;
    var orig = I.findRoot(state.orig['@graph']).root[f.prop];
    commitRootEdit(f.prop, fromInput(f, raw, orig));
  }
  function commitRootEdit(prop, v) {
    if (!state.orig) return;
    var orig = I.findRoot(state.orig['@graph']).root[prop];
    if (v === null && orig === undefined) delete state.edits.root[prop];      // never set, still empty
    else if (sameValue(v, orig)) delete state.edits.root[prop];                 // back to original
    else state.edits.root[prop] = v;                                            // null => remove
    onChange();
  }

  // ---- ontology-term editor (about: [{"@id", "@type": "DefinedTerm", "name"}])
  function termsFromValue(v) {
    return I.asList(v).map(function (t) {
      if (typeof t === 'string') return /^(https?:|urn:|ark:)/i.test(t) ? { iri: t, label: '', set: '' } : { iri: '', label: t, set: '' };
      if (t && typeof t === 'object') return { iri: t['@id'] || t.identifier || '', label: t.name || '', set: typeof t.inDefinedTermSet === 'string' ? t.inDefinedTermSet : (t.inDefinedTermSet && t.inDefinedTermSet['@id']) || '' };
      return { iri: '', label: '', set: '' };
    });
  }
  function termsToValue(terms) {
    var out = [];
    terms.forEach(function (t) {
      var iri = t.iri.trim(), label = t.label.trim(), set = t.set.trim();
      if (!iri && !label) return;
      if (!label) { out.push({ '@id': iri }); return; }
      var o = { '@id': iri || undefined, '@type': 'DefinedTerm', name: label };
      if (!iri) delete o['@id'];
      if (set) o.inDefinedTermSet = set;
      out.push(o);
    });
    return out.length ? out : null;
  }
  function buildTermsEditor(f, row) {
    var box = el('div', { class: 'terms' });
    var rows = el('div', { class: 'term-rows' });
    var vocabSel = el('select', {}, f.options.map(function (v, i) { return el('option', { value: String(i), text: v.name }); }));
    var add = el('button', { class: 'btn', type: 'button', text: '+ add term' });
    var hint = el('span', { class: 'help', text: '' });
    function currentVocab() { return f.options[Number(vocabSel.value)] || f.options[0]; }
    function updateHint() { var v = currentVocab(); hint.textContent = 'IRI pattern ' + v.iri; }
    vocabSel.addEventListener('change', updateHint); updateHint();
    add.addEventListener('click', function () { rows.appendChild(termRow({ iri: '', label: '', set: '' }, true)); commit(); });
    function commit() {
      var terms = Array.prototype.map.call(rows.querySelectorAll('.term-row'), function (r) {
        return { iri: r.querySelector('.t-iri').value, label: r.querySelector('.t-label').value, set: r.getAttribute('data-set') || '' };
      });
      commitRootEdit(f.prop, termsToValue(terms));
    }
    function termRow(t, focus) {
      var r = el('div', { class: 'term-row', 'data-set': t.set || '' });
      var iri = el('input', { type: 'text', class: 't-iri', placeholder: currentVocab().iri, value: t.iri });
      var label = el('input', { type: 'text', class: 't-label', placeholder: 'label, e.g. osteosarcoma cell line', value: t.label });
      var find = el('a', { class: 't-find', target: '_blank', rel: 'noopener', text: 'find' });
      var badge = el('span', { class: 't-badge' });
      var del = el('button', { class: 'btn t-del', type: 'button', text: '×', title: 'remove term' });
      function refresh() {
        var v = currentVocab();
        find.href = v.search + encodeURIComponent(label.value.trim() || iri.value.trim());
        var m = I.matchHost(iri.value, I.KNOWN.ONTOLOGY_HOSTS);
        badge.textContent = iri.value.trim() ? (m ? '✓ ' + m.label : '⚠ host not in the grader\'s ontology table') : '';
        badge.className = 't-badge ' + (iri.value.trim() ? (m ? 'yes' : 'warn') : '');
        r.setAttribute('data-set', m ? m.label.replace(' PURL', '') : '');
      }
      [iri, label].forEach(function (inp) { inp.addEventListener('input', function () { refresh(); commit(); }); });
      vocabSel.addEventListener('change', refresh);
      del.addEventListener('click', function () { r.remove(); commit(); });
      r.appendChild(iri); r.appendChild(label); r.appendChild(find); r.appendChild(del); r.appendChild(badge);
      refresh();
      if (focus) setTimeout(function () { iri.focus(); }, 0);
      return r;
    }
    box.appendChild(rows);
    box.appendChild(el('div', { class: 'term-tools' }, [vocabSel, add, hint]));
    box.render = function (value) {
      rows.innerHTML = '';
      termsFromValue(value).forEach(function (t) { rows.appendChild(termRow(t, false)); });
      if (!rows.children.length) rows.appendChild(el('div', { class: 'help', text: 'No terms yet — pick a vocabulary, add a term, paste its IRI (the "find" link searches the label).' }));
    };
    row._terms = box;
    return box;
  }

  // ------------------------------------------------ software table
  function buildSoftwareTables() {
    var cols = FIELDS.filter(function (f) { return f.entity === 'software'; });
    document.querySelectorAll('[data-swtable]').forEach(function (wrap) {
      var cid = wrap.getAttribute('data-swtable');
      wrap.innerHTML = '';
      if ((cid === 'all') !== (view === 'checklist')) return;   // only render the tables of the active view
      var sw = state.crate ? state.crate.stats.software : [];
      var myCols = cid === 'all' ? cols.slice().sort(function (a, b) { return a.effort - b.effort; }) : cols.filter(function (f) { return f.criteria[0] === cid; });
      var otherCols = cid === 'all' ? [] : cols.filter(function (f) { return f.criteria[0] !== cid && f.criteria.indexOf(cid) > 0; });
      var gc = $('[data-gcount="sw"]');
      if (gc && cid === 'all') {
        var missing = 0;
        sw.forEach(function (e) { myCols.forEach(function (f) { var ed = (state.edits.software[String(e['@id'])] || {})[f.prop]; if (!(ed !== undefined ? ed !== null : I.nonblank(e[f.prop]))) missing += 1; }); });
        gc.textContent = sw.length ? sw.length + ' entities · ' + missing + ' empty cells' : 'none in crate';
      }
