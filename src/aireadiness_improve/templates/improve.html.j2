    $('#sections').classList.toggle('hidden', mode !== 'criteria');
    $('#toc').classList.toggle('hidden', mode !== 'criteria');
    $('#secmenu').classList.toggle('hidden', mode !== 'criteria');
    var rows = Array.prototype.slice.call(document.querySelectorAll('.field[data-prop]'));
    if (mode === 'checklist') {
      // order: effort, then fields whose score moves mechanically, then catalogue order
      rows.sort(function (a, b) {
        var fa = FIELD_BY_PROP['root:' + a.getAttribute('data-prop')], fb = FIELD_BY_PROP['root:' + b.getAttribute('data-prop')];
        var ka = [fa.effort, fa.win ? 0 : 1, FIELDS.indexOf(fa)], kb = [fb.effort, fb.win ? 0 : 1, FIELDS.indexOf(fb)];
        for (var i = 0; i < ka.length; i++) if (ka[i] !== kb[i]) return ka[i] - kb[i];
        return 0;
      });
      rows.forEach(function (r) { $('[data-glist="' + r.getAttribute('data-effort') + '"]').appendChild(r); });
    } else {
      rows.forEach(function (r) { var home = $('#' + anchorId(r.getAttribute('data-home')) + ' .fields'); if (home) home.appendChild(r); });
    }
    try { localStorage.setItem('improve:view', mode); } catch (e) { /* ignore */ }
    buildSoftwareTables();
    applyFilter();
  }
  function isFilled(row) { return row.classList.contains('filled'); }
  function applyFilter() {
    var hide = $('#hide-filled').checked;
    var rows = Array.prototype.slice.call(document.querySelectorAll('.field[data-prop]'));
    var filled = 0;
    rows.forEach(function (r) {
      if (isFilled(r)) filled += 1;
      r.classList.toggle('hidden', hide && isFilled(r));
    });
    [1, 2, 3].forEach(function (level) {
      var inGroup = rows.filter(function (r) { return Number(r.getAttribute('data-effort')) === level; });
      var left = inGroup.filter(function (r) { return !isFilled(r); }).length;
      var gc = $('[data-gcount="' + level + '"]'); if (gc) gc.textContent = left ? left + ' of ' + inGroup.length + ' to fill' : 'all ' + inGroup.length + ' filled';
      var ge = $('[data-gempty="' + level + '"]'); if (ge) ge.classList.toggle('hidden', !(hide && left === 0 && inGroup.length));
      var g = $('#effort' + level); if (g) g.classList.toggle('hidden', view === 'checklist' && hide && left === 0);
    });
    $('#field-progress').innerHTML = '<b>' + filled + '</b> / ' + rows.length + ' fields filled';
    $('#done-banner').classList.toggle('hidden', !(state.orig && filled === rows.length));
    try { localStorage.setItem('improve:hideFilled', hide ? '1' : '0'); } catch (e) { /* ignore */ }
  }
  function visibleRow(r) {
    for (var n = r; n; n = n.parentElement) if (n.classList && n.classList.contains('hidden')) return false;
    return true;
  }

  function buildCriterion(c) {
