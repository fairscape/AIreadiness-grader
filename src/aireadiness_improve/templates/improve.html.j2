    var g = state.prior && state.prior.grade;
    if (g && g.criteria) {
      g.criteria.forEach(function (c) { (c.rubrics || []).forEach(function (r) { if (r.id === cid) out.push('graded ' + r.score + (g.model ? ' by ' + g.model : '')); }); });
    }
    return out.length ? 'Prior: ' + out.join(' · ') : '';
  }

  function renderFooterPrior() {
    var g = state.prior && state.prior.grade;
    $('#footer-prior').textContent = g
      ? ' · prior grade ' + g.total_score + (g.max_score !== undefined ? '/' + g.max_score : '') +
        (g.overall_score !== undefined ? ' (' + g.overall_score + '% overall)' : '') +
        (g.model ? ' by ' + g.model : '')
      : '';
  }

  function renderScores() {
    var doc = currentDoc();
    state.crate = I.loadCrate(doc);
    var est = I.estimateAll(state.crate, { hasDatasheet: state.hasDatasheet });
    var agg = I.aggregate(est);
    // per criterion
    for (var cid in CRITERIA) {
      var e = est[cid];
      var box = $('[data-est="' + cid + '"]'); box.innerHTML = '';
      box.appendChild(el('span', { class: 'est-badge', text: 'Estimate' }));
      box.appendChild(chip(e.score));
      box.appendChild(document.createTextNode(e.score === null ? ' needs a human read' : ''));
      box.appendChild(el('ul', {}, e.basis.map(function (b) { return el('li', { text: b }); })));
      var pri = priorFor(cid); if (pri) box.appendChild(el('div', { class: 'prior', text: pri }));
      var ch = $('[data-chip="' + cid + '"]');
      ch.className = 'chip ' + (e.score === null ? 'sq' : 's' + e.score);
      ch.textContent = cid.split('.')[1];
      ch.title = cid + ' ' + CRITERIA[cid].name + ' — estimate ' + (e.score === null ? '?' : e.score);
      document.querySelectorAll('[data-whychip="' + cid + '"]').forEach(function (wc) {
        wc.className = 'chip ' + (e.score === null ? 'sq' : 's' + e.score);
        wc.textContent = e.score === null ? '?' : String(e.score);
      });
    }
    applyFilter();
    // sections
    SECTIONS.forEach(function (s) {
      var sec = agg.sections[String(s.number)] || { points: 0, max: 0, human: 0 };
      var ax = $('[data-section="' + s.number + '"]');
      ax.innerHTML = '<b>' + sec.points + '</b> / ' + sec.max + ' est. pts' + (sec.human ? ' · ' + sec.human + ' human' : '');
      var stat = $('[data-secstat="' + s.number + '"]');
      stat.textContent = sec.points + '/' + sec.max + ' pts' + (sec.human ? ' · ' + sec.human + ' need' + (sec.human === 1 ? 's' : '') + ' a human read' : '');
    });
    // summary bar
    var base = state.base;
    $('#est-score').textContent = agg.points + '/' + agg.max + (agg.human ? ' (' + agg.human + ' need review)' : '');
    $('#est-fill').style.width = (agg.max ? 100 * agg.points / agg.max : 0) + '%';
    $('#est-base').style.width = (base.est.max ? 100 * base.est.points / base.est.max : 0) + '%';
    $('#est-delta').textContent = agg.points > base.est.points ? ' +' + (agg.points - base.est.points) : (agg.points < base.est.points ? ' ' + (agg.points - base.est.points) : '');
    $('#gate-line').textContent = agg.gateFailures.length ? '⚠ gate: ' + agg.gateFailures.join('; ') : 'estimated gates pass';
    $('#gate-line').style.color = agg.gateFailures.length ? 'var(--bad)' : 'var(--ok)';
    renderFooterPrior();
    renderValidation(doc);
    renderChanges();
  }

  function renderValidation(doc) {
    var box = $('#validation'), line = $('#valid-line');
    if (!SCHEMAS.root) { box.classList.add('hidden'); line.textContent = 'schema validation unavailable (fairscape_models not installed when this page was built)'; line.className = 'valid'; return; }
    var root = I.findRoot(doc['@graph']).root;
    var errors = I.validate(SCHEMAS.root, root).map(function (e) { return { where: 'root', path: e.path, message: e.message }; });
    doc['@graph'].forEach(function (e) {
      if (I.canonicalType(e) !== 'Software') return;
      if (!state.edits.software[String(e['@id'])]) return;   // only validate software we touched
      I.validate(SCHEMAS.software, e).forEach(function (err) { errors.push({ where: e.name || e['@id'], path: err.path, message: err.message }); });
    });
    var originalRoot = I.findRoot(state.orig['@graph']).root;
    var origErrors = I.validate(SCHEMAS.root, originalRoot).length;
    if (!errors.length) {
      box.classList.add('hidden');
      line.textContent = '✓ valid against fairscape_models ' + (SCHEMAS.version || '') + (origErrors ? ' (' + origErrors + ' pre-existing issue(s) fixed)' : '');
      line.className = 'valid ok';
      return;
    }
    box.classList.remove('hidden');
    box.innerHTML = '';
    box.appendChild(el('strong', { text: 'Schema check (fairscape_models ' + (SCHEMAS.version || '') + '): ' + errors.length + ' issue(s)' }));
    box.appendChild(el('span', { class: 'dim', text: origErrors ? ' — ' + origErrors + ' were already in the crate before editing; the download is never blocked.' : ' — the download is never blocked.' }));
    var ul = el('ul');
    errors.forEach(function (err) {
      var li = el('li', {}, [el('span', { class: 'mono', text: err.where + err.path }), ' ' + err.message]);
      var prop = err.path.replace(/^\//, '').split(/[\/\[]/)[0];
      var f = FIELD_BY_PROP['root:' + prop];
      var val = root[prop];
      if (err.where === 'root' && typeof val === 'string' && /array/.test(err.message) && f && f.type !== 'list' && f.type !== 'idlist') {
        var b = el('button', { class: 'btn', type: 'button', text: 'fix: wrap in a list' });
        b.addEventListener('click', function () { state.edits.root[prop] = [val]; onChange(); });
        li.appendChild(b);
      } else if (err.where === 'root' && f) {
        var a = el('a', { href: '#' + anchorId(f.criteria[0]), text: 'go to field' }); li.appendChild(document.createTextNode(' ')); li.appendChild(a);
      }
      ul.appendChild(li);
    });
    box.appendChild(ul);
    line.textContent = '⚠ ' + errors.length + ' schema issue(s)';
    line.className = 'valid bad';
  }

  function renderChanges() {
    var box = $('#changes'), items = [];
    for (var p in state.edits.root) items.push('root ' + p + (state.edits.root[p] === null ? ' — removed' : ''));
    for (var id in state.edits.software) for (var q in state.edits.software[id]) items.push('software ' + id + ' ' + q + (state.edits.software[id][q] === null ? ' — removed' : ''));
    if (!items.length) { box.classList.add('hidden'); return; }
    box.classList.remove('hidden'); box.innerHTML = '';
    box.appendChild(el('strong', { text: items.length + ' change(s) pending' }));
    box.appendChild(el('ul', {}, items.map(function (t) { return el('li', { class: 'mono', text: t }); })));
  }

  function renderAll() { renderFields(); buildSoftwareTables(); renderScores(); }
  var timer = null;
  function onChange() {
    try { localStorage.setItem(storageKey(), JSON.stringify({ edits: state.edits, hasDatasheet: state.hasDatasheet })); } catch (e) { /* ignore */ }
    clearTimeout(timer);
    timer = setTimeout(function () { renderFields(); renderScores(); }, 150);
  }

  // ------------------------------------------------ export
  function downloadText(name, text, mime) {
    var blob = new Blob([text], { type: mime || 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  }
  function doDownload() {
    if (!state.orig) return;
    downloadText('ro-crate-metadata.json', JSON.stringify(currentDoc(), null, 2));
    $('#export-msg').textContent = 'downloaded ro-crate-metadata.json — replace the file in your crate directory';
  }
  $('#download').addEventListener('click', doDownload);
  $('#download-top').addEventListener('click', doDownload);
  $('#download-patch').addEventListener('click', function () {
    if (!state.orig) return;
    downloadText('ro-crate-edits.json', JSON.stringify({ crate: String(state.crate.root['@id']), edits: state.edits }, null, 2));
  });
  $('#copy').addEventListener('click', function () {
    if (!state.orig) return;
    var txt = JSON.stringify(currentDoc(), null, 2);
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(function () { $('#export-msg').textContent = 'copied ' + txt.length + ' chars'; });
    else { var ta = el('textarea', { text: txt }); document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); $('#export-msg').textContent = 'copied'; }
  });
  $('#reset').addEventListener('click', function () {
    if (!state.orig) return;
    if (!confirm('Discard every edit made in this page?')) return;
    state.edits = { root: {}, software: {} };
    try { localStorage.removeItem(storageKey()); } catch (e) { /* ignore */ }
    renderAll();
  });
  $('#next-empty').addEventListener('click', function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('.field.empty')).filter(visibleRow);
    if (!rows.length) return;
    var y = window.scrollY + 70;
    var next = rows.filter(function (r) { return r.getBoundingClientRect().top + window.scrollY > y; })[0] || rows[0];
    if (next.scrollIntoView) next.scrollIntoView({ behavior: 'smooth', block: 'center' });
    var inp = next.querySelector('input, textarea, select'); if (inp) setTimeout(function () { inp.focus(); }, 400);
  });

  // ------------------------------------------------ file loading
  function readFile(file, cb) {
    var r = new FileReader();
    r.onload = function () { try { cb(JSON.parse(r.result)); } catch (err) { alert('Not JSON: ' + err.message); } };
    r.readAsText(file);
  }
  function ingestScore(obj) {
    if (obj && obj.criteria && obj.total_score !== undefined) state.prior.grade = obj;
    else { alert('Unrecognised score file (expected aggregated_score.json)'); return; }
    if (state.orig) renderScores();
  }
  $('#file-crate').addEventListener('change', function (ev) { if (ev.target.files[0]) readFile(ev.target.files[0], function (d) { loadDoc(d, ev.target.files[0].name); }); });
  $('#file-score').addEventListener('change', function (ev) { if (ev.target.files[0]) readFile(ev.target.files[0], ingestScore); });
  var lb = $('#loadbox');
  ['dragenter', 'dragover'].forEach(function (t) { lb.addEventListener(t, function (e) { e.preventDefault(); lb.classList.add('drag'); }); });
  ['dragleave', 'drop'].forEach(function (t) { lb.addEventListener(t, function (e) { e.preventDefault(); lb.classList.remove('drag'); }); });
  lb.addEventListener('drop', function (e) {
    var f = e.dataTransfer.files[0]; if (!f) return;
    readFile(f, function (d) { if (d && d['@graph']) loadDoc(d, f.name); else ingestScore(d); });
  });

  // ------------------------------------------------ views & filter
  $('#view-checklist').addEventListener('click', function () { setView('checklist'); });
  $('#view-criteria').addEventListener('click', function () { setView('criteria'); });
  $('#hide-filled').addEventListener('change', applyFilter);
  // criterion links (from a field's "for …" line or the section panel) open the criterion view
  document.addEventListener('click', function (ev) {
    var a = ev.target.closest ? ev.target.closest('a[href^="#c"], a[href^="#sec"]') : null;
    if (a && view !== 'criteria') { setView('criteria'); }
  });

  buildStructure();
  var savedView = 'checklist', savedHide = false;
  try { savedView = localStorage.getItem('improve:view') || 'checklist'; savedHide = localStorage.getItem('improve:hideFilled') === '1'; } catch (e) { /* ignore */ }
  $('#hide-filled').checked = savedHide;
  setView(savedView === 'criteria' ? 'criteria' : 'checklist');
  if (EMBEDDED && EMBEDDED['@graph']) loadDoc(EMBEDDED, LABEL);
})();
</script>
</body>
</html>
