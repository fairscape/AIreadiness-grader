{% macro value(it) -%}
  {%- if it.kind == "bool" -%}
    {%- if it.value is none %}<span class="na">inconclusive</span>
    {%- elif it.value %}<span class="yes">yes</span>
    {%- else %}<span class="no">no</span>{% endif -%}
  {%- elif it.kind == "count" -%}
    {{ "{:,}".format(it.value) }}{% if it.of is defined and it.of is not none %} of {{ "{:,}".format(it.of) }}{% endif %}
  {%- elif it.kind == "percent" -%}
    {%- if it.value is none %}<span class="na">n/a</span>
    {%- else %}<span class="pct-bar"><span style="width:{{ it.value }}%"></span></span>{{ it.value }}%
      {%- if it.n is defined and it.n is not none %} <span class="detail-plain">({{ "{:,}".format(it.n) }} of {{ "{:,}".format(it.total) }})</span>{% endif -%}
    {%- endif -%}
  {%- elif it.kind == "link" -%}
    <a href="{{ it.value | href }}">{{ it.text or it.value }}</a>
  {%- elif it.kind == "links" -%}
    {%- for l in it.value %}<a href="{{ l.href | href }}">{{ l.text or l.href }}</a>{% if not loop.last %}, {% endif %}{% endfor -%}
    {%- if not it.value %}<span class="na">none</span>{% endif -%}
  {%- elif it.kind == "list" -%}
    {%- if it.value %}{{ it.value | join(", ") | linkify }}{% else %}<span class="na">none</span>{% endif -%}
  {%- elif it.kind == "entity" -%}
    {%- if it.value is none %}<span class="na">none</span>
    {%- else %}<details class="entity"><summary>JSON entity</summary><pre>{{ it.value | tojson_pretty }}</pre></details>{% endif -%}
  {%- else -%}
    {%- if it.value is none %}<span class="na">none</span>{% else %}<span class="pre">{{ it.value | linkify }}</span>{% endif -%}
  {%- endif -%}
  {%- if it.detail %}<span class="detail">{{ it.detail | linkify }}</span>{% endif -%}
{%- endmacro %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI-Readiness Agentic Review — {{ r.crate.name }}</title>
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --line: #d9d9d9; --bg: #fafaf8;
    --card: #ffffff; --accent: #b45309; --ok: #15803d; --bad: #b91c1c;
    --mid: #a16207; --unknown: #6b6b6b; --gate: #7c2d12;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 14px/1.45 "Source Sans 3", "Segoe UI", system-ui, sans-serif; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
  .mono { font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
          font-size: 0.86em; }
  a { color: var(--accent); }
  header { border-bottom: 2px solid var(--ink); background: var(--card);
           padding: 16px 0 12px; }
  h1 { font-size: 1.25rem; margin: 0 0 2px; }
  h2 { font-size: 1.05rem; border-bottom: 1px solid var(--line);
       padding-bottom: 4px; margin: 26px 0 10px; display: flex;
       align-items: baseline; justify-content: space-between; gap: 12px; }
  .meta { color: var(--muted); font-size: 0.85rem; }
  .badge { display: inline-block; border: 1px solid var(--gate);
           color: var(--gate); border-radius: 2px; font-size: 0.68rem;
           padding: 0 5px; margin-left: 8px; vertical-align: 2px;
           text-transform: uppercase; letter-spacing: 0.05em; }

  .method { background: var(--card); border: 1px solid var(--line);
            border-left: 3px solid var(--accent); border-radius: 2px;
            padding: 9px 14px; margin: 14px 0; font-size: 0.85rem;
            color: #333; }
  .method p { margin: 0 0 5px; }
  .method p:last-child { margin-bottom: 0; }

  .summary { display: flex; gap: 26px; align-items: flex-start;
             flex-wrap: wrap; background: var(--card);
             border: 1px solid var(--line); border-radius: 2px;
             padding: 14px 16px; margin: 14px 0 4px; }
  .total { font-size: 2.1rem; font-weight: 700; line-height: 1; }
  .total small { font-size: 0.95rem; font-weight: 400; color: var(--muted); }
  .totbox { flex: 0 0 auto; min-width: 150px; }
  .totbox .counts { font-size: 0.82rem; color: var(--muted); margin-top: 8px;
                    line-height: 1.7; }
  .gatever { margin-top: 10px; font-size: 0.83rem; }
  .sectable { flex: 1 1 300px; border-collapse: collapse; font-size: 0.86rem; }
  .sectable th { text-align: left; font-size: 0.72rem; text-transform: uppercase;
                 letter-spacing: 0.05em; color: var(--muted); font-weight: 600;
                 border-bottom: 1px solid var(--line); padding: 2px 10px 3px 0; }
  .sectable td { padding: 3px 10px 3px 0; border-bottom: 1px dotted #ececea; }
  .sectable td.num { text-align: right; white-space: nowrap; }
  .sectable tr:last-child td { border-bottom: 0; }
  .radar-box { flex: 0 0 auto; }
  .radar-box svg { display: block; }
  .radar-cap { font-size: 0.78rem; color: var(--muted); text-align: center; }

  .chip { display: inline-block; min-width: 20px; text-align: center;
          border: 1px solid var(--line); border-radius: 2px; font-weight: 700;
          font-size: 0.8rem; padding: 0 6px; }
  .chip.s2 { border-color: var(--ok); color: #fff; background: var(--ok); }
  .chip.s1 { border-color: var(--mid); color: #fff; background: var(--mid); }
  .chip.s0 { border-color: var(--bad); color: #fff; background: var(--bad); }
  .chip.sx { color: var(--muted); }

  .criterion { background: var(--card); border: 1px solid var(--line);
               border-radius: 2px; padding: 10px 14px; margin: 0 0 10px; }
  .criterion.s0 { border-left: 3px solid var(--bad); }
  .criterion.s1 { border-left: 3px solid var(--mid); }
  .criterion.s2 { border-left: 3px solid var(--ok); }
  .chead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .chead h3 { margin: 0; font-size: 0.98rem; }
  .chead .lab { font-size: 0.78rem; color: var(--muted);
                text-transform: uppercase; letter-spacing: 0.05em; }
  .practice { color: var(--muted); font-style: italic; margin: 3px 0 6px;
              font-size: 0.84rem; }
  .rule { font-size: 0.82rem; color: #333; background: #fcfcfa;
          border: 1px solid var(--line); border-radius: 2px;
          padding: 3px 8px; margin: 0 0 7px; }
  .rule b { font-weight: 700; }
  .rationale { margin: 0 0 7px; }
  .sub { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
         color: var(--muted); font-weight: 600; margin: 7px 0 2px; }
  ul.cite { margin: 0; padding-left: 18px; font-size: 0.85rem; }
  ul.cite li { margin: 1px 0; overflow-wrap: break-word; }
  ul.cite.gaps li { color: #333; }
  .disagree { font-size: 0.8rem; color: var(--gate); margin-top: 7px; }

  details.raw { margin-top: 8px; font-size: 0.85rem; }
  details.raw > summary { cursor: pointer; color: var(--muted);
                          font-size: 0.8rem; }
  .item { display: flex; gap: 12px; padding: 2px 0; font-size: 0.84rem;
          border-top: 1px dotted #ececea; }
  .item .label { flex: 0 0 280px; font-weight: 600; }
  .item.subitem .label { color: var(--muted); font-weight: 400;
                         padding-left: 14px; }
  .item .value { flex: 1; min-width: 0; overflow-wrap: break-word; }
  .pre { white-space: pre-line; }
  .detail, .detail-plain { color: var(--muted); font-size: 0.8rem; }
  .detail::before { content: " — "; }
  .yes { color: var(--ok); font-weight: 600; }
  .no { color: var(--bad); font-weight: 600; }
  .na { color: var(--unknown); }
  .pct-bar { display: inline-block; width: 80px; height: 7px; background: #eee;
             border-radius: 2px; margin-right: 6px; vertical-align: 1px; }
  .pct-bar span { display: block; height: 100%; background: var(--accent);
                  border-radius: 2px; }
  details.entity { display: inline; }
  details.entity summary { cursor: pointer; color: var(--accent); }
  details.entity pre { background: #f4f4f2; border: 1px solid var(--line);
                       border-radius: 2px; padding: 8px; overflow-x: auto;
                       font-size: 0.75rem; max-height: 300px; margin: 4px 0; }
  footer { margin: 30px 0 40px; font-size: 0.8rem; color: var(--muted); }
  @media print { body { background: #fff; } .criterion { break-inside: avoid; } }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>AI-Readiness Review — agentic pre-scoring</h1>
    <div class="meta">
      {{ r.rubric }} · evidence generated {{ r.generated }}
      {%- if not r.network_checks %} · <strong>network checks disabled</strong>{% endif %}
    </div>
    <div style="margin-top:6px">
      <strong>{{ r.crate.name }}</strong>
      <span class="mono">{{ r.crate["@id"] }}</span>
      <span class="meta"> · {{ r.crate.identifier }}{% if r.crate.version %} · v{{ r.crate.version }}{% endif %}</span>
    </div>
    {% if r.artifacts.datasheets %}
    <div style="margin-top:6px;font-size:0.88rem">
      {% for d in r.artifacts.datasheets %}<a href="{{ d | href }}">Datasheet — {{ d }}</a> {% endfor %}
    </div>
    {% endif %}
  </div>
</header>

<div class="wrap">

  <div class="method">
    <p><strong>These scores were produced by a machine, not a reviewer.</strong>
    Each of the {{ r.sections | map(attribute='criteria') | map('length') | sum }}
    criteria was scored by a grading agent that saw only two things: the
    criterion's rubric text (practice, questions, 0/1/2 rules) and the evidence
    extracted from this crate for that criterion. It saw no other criterion's
    verdict, no prior scores for this or any other dataset, and nothing about
    the project beyond the crate's own metadata.</p>
    <p>The evidence underneath every score is the same deterministic extraction
    that fills the blank human-review page — the agent judged which rule
    matched; it did not gather the facts. Treat this document as a first pass
    to confirm or overturn: expand <em>Extracted evidence</em> on any criterion
    to see exactly what the verdict was based on.
    {%- if r.grader %} Scored by {{ r.grader }}.{% endif %}</p>
  </div>

  <div class="summary">
    <div class="totbox">
      <div class="total">{{ r.total.points }}<small> / {{ r.total.max }}</small></div>
      <div class="meta">{{ r.total.percentage }}% of possible points</div>
      <div class="counts">
        <span class="chip s2">2</span> {{ r.total.counts.substantive }} substantive<br>
        <span class="chip s1">1</span> {{ r.total.counts.partial }} partial<br>
        <span class="chip s0">0</span> {{ r.total.counts.absent }} absent
        {%- if r.total.counts.unscored %}<br><span class="chip sx">–</span> {{ r.total.counts.unscored }} not scored{% endif %}
      </div>
      {% for g in r.gating %}
      <div class="gatever">
        <strong>Gate — {{ g.number }}. {{ g.title }}:</strong>
        {% if g.passed %}<span class="yes">passed</span>{% else %}<span class="no">not met</span>{% endif %}
        <span class="meta">({{ g.points }}/{{ g.max }}; threshold is all 2s)</span>
      </div>
      {% endfor %}
    </div>

    <div class="radar-box">
      <svg width="{{ r.radar.width }}" height="{{ r.radar.height }}"
           viewBox="0 0 {{ r.radar.width }} {{ r.radar.height }}"
           role="img" aria-label="Per-section score radar chart">
        {% for ring in r.radar.rings %}
        <polygon points="{{ ring.points }}" fill="none" stroke="#e2e2df"
                 stroke-width="1"></polygon>
        {% endfor %}
        {% for pt in r.radar.spokes %}
        <line x1="{{ r.radar.cx }}" y1="{{ r.radar.cy }}"
              x2="{{ pt.split(',')[0] }}" y2="{{ pt.split(',')[1] }}"
              stroke="#e2e2df" stroke-width="1"></line>
        {% endfor %}
        <polygon points="{{ r.radar.polygon }}" fill="rgba(180,83,9,0.14)"
                 stroke="#b45309" stroke-width="2"></polygon>
        {% for v in r.radar.vertices %}
        <circle cx="{{ v.xy.split(',')[0] }}" cy="{{ v.xy.split(',')[1] }}"
                r="3" fill="#b45309"></circle>
        {% endfor %}
        {% for a in r.radar.axes %}
        <text x="{{ a.x }}" y="{{ a.y }}" text-anchor="{{ a.anchor }}"
              font-size="10" fill="#1a1a1a"
              font-family="Source Sans 3, Segoe UI, system-ui, sans-serif"
          >{{ a.number }}. {{ a.title }}</text>
        <text x="{{ a.x }}" y="{{ a.y + 11 }}" text-anchor="{{ a.anchor }}"
              font-size="9" fill="#6b6b6b"
              font-family="Source Sans 3, Segoe UI, system-ui, sans-serif"
          >{{ a.points }}/{{ a.max }}</text>
        {% endfor %}
      </svg>
      <div class="radar-cap">Section score as % of that section's maximum</div>
    </div>

    <table class="sectable">
      <tr><th>Section</th><th class="num">Points</th><th class="num">%</th><th>Criteria</th></tr>
      {% for s in r.sections %}
      <tr>
        <td><a href="#sec{{ s.number }}">{{ s.number }}. {{ s.title }}</a>{% if s.gating %} *{% endif %}</td>
        <td class="num">{{ s.points }} / {{ s.max }}</td>
        <td class="num">{{ s.percentage }}%</td>
        <td>{% for c in s.criteria %}<span class="chip s{{ c.score if c.score is not none else 'x' }}"
              title="{{ c.id }} {{ c.name }}">{{ c.score if c.score is not none else '–' }}</span> {% endfor %}</td>
      </tr>
      {% endfor %}
      <tr><td colspan="4" class="meta">* gating section</td></tr>
    </table>
  </div>

  {% if r.worst %}
  <h2 id="gaps"><span>Where the points went</span></h2>
  <table class="sectable" style="width:100%">
    <tr><th>Criterion</th><th class="num">Score</th><th>First gap named by the grader</th></tr>
    {% for c in r.worst %}
    <tr>
      <td><a href="#c{{ c.id | replace('.', '-') }}">{{ c.id }} {{ c.name }}</a></td>
      <td class="num"><span class="chip s{{ c.score }}">{{ c.score }}</span></td>
      <td>{{ c.gaps[0] if c.gaps else "—" }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% for s in r.sections %}
  <h2 id="sec{{ s.number }}">
    <span>{{ s.number }}. {{ s.title }}{% if s.gating %}<span class="badge">Gating</span>{% endif %}</span>
    <span class="meta">{{ s.points }} / {{ s.max }} · {{ s.percentage }}%</span>
  </h2>

    {% for c in s.criteria %}
    <div class="criterion s{{ c.score if c.score is not none else 'x' }}"
         id="c{{ c.id | replace('.', '-') }}">
      <div class="chead">
        <span class="chip s{{ c.score if c.score is not none else 'x' }}"
          >{{ c.score if c.score is not none else '–' }}</span>
        <h3>{{ c.id }} {{ c.name }}</h3>
        <span class="lab">{{ c.label }}</span>
      </div>
      <div class="practice">{{ c.practice }}</div>
      {% if c.score is not none and c.scoring.get(c.score | string) %}
      <div class="rule"><b>Rule for {{ c.score }}:</b> {{ c.scoring[c.score | string] }}</div>
      {% endif %}
      <p class="rationale">{{ c.rationale | linkify }}</p>

      {% if c.cited %}
      <div class="sub">Evidence cited</div>
      <ul class="cite">{% for e in c.cited %}<li class="mono">{{ e | linkify }}</li>{% endfor %}</ul>
      {% endif %}

      {% if c.gaps %}
      <div class="sub">What would raise the score</div>
      <ul class="cite gaps">{% for g in c.gaps %}<li>{{ g | linkify }}</li>{% endfor %}</ul>
      {% endif %}

      {% if c.estimate_differs %}
      <div class="disagree">The rule-based estimate in the evidence pipeline
        scored this {{ c.estimate_score }}; the grading agent scored it
        {{ c.score }}. Worth a human look.</div>
      {% endif %}

      <details class="raw">
        <summary>Extracted evidence ({{ c.evidence | length }} items)</summary>
        {% for it in c.evidence %}
        <div class="item{% if it.sub %} subitem{% endif %}">
          <div class="label">{{ it.label }}</div>
          <div class="value">{{ value(it) }}</div>
        </div>
        {% endfor %}
      </details>
    </div>
    {% endfor %}
  {% endfor %}

  <footer>
    {{ r.rubric }}. Crate: <span class="mono">{{ r.crate["@id"] }}</span>
    ({{ "{:,}".format(r.inventory.entities) }} entities{% if r.inventory.sub_crates %},
    {{ r.inventory.sub_crates | length }} sub-crates{% endif %}).
    Evidence extracted {{ r.generated }}. Scores are machine-generated and
    unconfirmed by a human reviewer.
  </footer>
</div>
</body>
</html>
