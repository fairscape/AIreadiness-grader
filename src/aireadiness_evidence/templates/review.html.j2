<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI-Readiness Review — {{ p.crate.name }}</title>
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --line: #d9d9d9; --bg: #fafaf8;
    --card: #ffffff; --accent: #b45309; --ok: #15803d; --bad: #b91c1c;
    --unknown: #6b6b6b; --gate: #7c2d12;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 14px/1.45 "Source Sans 3", "Segoe UI", system-ui, sans-serif; }
  .mono { font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
          font-size: 0.86em; }
  a { color: var(--accent); }
  header { border-bottom: 2px solid var(--ink); padding: 16px 0 12px;
           background: var(--card); }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  h1 { font-size: 1.25rem; margin: 0 0 2px; }
  h2 { font-size: 1.05rem; border-bottom: 1px solid var(--line);
       padding-bottom: 4px; margin: 26px 0 10px;
       display: flex; align-items: baseline; justify-content: space-between;
       gap: 12px; flex-wrap: wrap;
       /* clears the sticky summary bar when the TOC jumps to a section */
       scroll-margin-top: 48px; }
  .meta { color: var(--muted); font-size: 0.85rem; }
  .badge { display: inline-block; border: 1px solid var(--gate);
           color: var(--gate); border-radius: 2px; font-size: 0.68rem;
           padding: 0 5px; margin-left: 8px; vertical-align: 2px;
           text-transform: uppercase; letter-spacing: 0.05em; }
  .toplinks { margin-top: 6px; font-size: 0.88rem; }
  .toplinks a { margin-right: 16px; }
  nav.toc { margin: 14px 0; font-size: 0.88rem; }
  nav.toc a { margin-right: 12px; white-space: nowrap; }
  .inventory { background: var(--card); border: 1px solid var(--line);
               border-radius: 2px; padding: 8px 12px; margin: 12px 0;
               font-size: 0.85rem; }
  .inventory table { border-collapse: collapse; margin-top: 6px; }
  .inventory th { text-align: left; padding: 2px 14px 3px 0;
                  font-size: 0.72rem; text-transform: uppercase;
                  letter-spacing: 0.05em; color: var(--muted);
                  font-weight: 600; border-bottom: 1px solid var(--line); }
  .inventory td { padding: 2px 14px 2px 0; border-bottom: 1px dotted #ececea; }
  .inventory tr:last-child td { border-bottom: 0; }
  .inventory td.num { text-align: right; }
  .inventory th.num { text-align: right; }

  .criterion { background: var(--card); border: 1px solid var(--line);
               border-radius: 2px; padding: 10px 14px 8px; margin: 0 0 10px; }
  .criterion h3 { margin: 0; font-size: 0.98rem; display: inline; }
  .practice { color: var(--muted); font-style: italic; margin: 2px 0 6px;
              font-size: 0.85rem; }
  details.questions { margin: 0 0 6px; font-size: 0.85rem; }
  details.questions summary { cursor: pointer; color: var(--muted); }
  details.questions ul { margin: 4px 0 2px; padding-left: 20px; }

  .scores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
            margin: 6px 0 8px; }
  .scores > div { border: 1px solid var(--line); border-radius: 2px;
                  padding: 4px 8px; font-size: 0.8rem; line-height: 1.35;
                  color: #333; background: #fcfcfa; }
  .scores .n { font-weight: 700; margin-right: 6px; font-size: 0.9rem; }
  .rubric-note { color: var(--muted); font-size: 0.78rem; margin: -2px 0 6px; }

  .evidence { border-top: 1px solid var(--line); padding-top: 4px; }
  .item { display: flex; gap: 12px; padding: 2px 0; font-size: 0.86rem;
          border-top: 1px dotted #ececea; }
  .item:first-child { border-top: 0; }
  .item .label { flex: 0 0 290px; color: var(--ink); font-weight: 600; }
  .item.sub .label { color: var(--muted); font-weight: 400;
                     padding-left: 16px; }
  .item .value { flex: 1; min-width: 0; overflow-wrap: break-word; }
  .pre { white-space: pre-line; }
  .detail { color: var(--muted); font-size: 0.8rem; display: inline;
            margin-left: 6px; }
  .detail::before { content: "— "; }
  .yes { color: var(--ok); font-weight: 600; }
  .no { color: var(--bad); font-weight: 600; }
  .na { color: var(--unknown); }
  .pct-bar { display: inline-block; width: 90px; height: 7px;
             background: #eee; border-radius: 2px; margin-right: 6px;
             vertical-align: 1px; }
  .pct-bar span { display: block; height: 100%; background: var(--accent);
                  border-radius: 2px; }
  details.entity { display: inline; }
  details.entity pre { background: #f4f4f2; border: 1px solid var(--line);
                       border-radius: 2px; padding: 8px; overflow-x: auto;
                       font-size: 0.75rem; max-height: 320px; margin: 4px 0; }
  details.entity summary { cursor: pointer; color: var(--accent); }
  ul.plain { margin: 0; padding-left: 16px; }
  ul.plain li { margin: 0; }
  .longtext { display: inline; }
  .longtext summary { cursor: pointer; display: inline; color: inherit; }
  .longtext summary .more { color: var(--accent); font-size: 0.8rem; }
  .longtext[open] summary .head { display: none; }

  .summarybar { position: sticky; top: 0; z-index: 10; background: var(--card);
                border-bottom: 1px solid var(--line); padding: 7px 0;
                font-size: 0.88rem; }
  .summarybar .wrap { display: flex; align-items: center; gap: 14px;
                      flex-wrap: wrap; }
  .summarybar .pct-bar { width: 160px; height: 9px; }
  .summarybar .score { font-weight: 700; }

  .axis-score { font-size: 0.75rem; font-weight: 400; color: var(--muted);
                border: 1px solid var(--line); border-radius: 2px;
                padding: 1px 8px; background: var(--card); white-space: nowrap; }
  .axis-score .ax-pts { font-weight: 700; color: var(--ink); }
  .axis-score.complete { border-color: var(--accent); }

  details.secmenu > summary { cursor: pointer; list-style: none;
    border: 1px solid var(--line); border-radius: 2px; padding: 2px 10px;
    font-size: 0.82rem; user-select: none; }
  details.secmenu > summary::-webkit-details-marker { display: none; }
  details.secmenu > summary::after { content: " ▾"; color: var(--muted); }
  details.secmenu[open] > summary { border-color: var(--accent); }
  /* anchored to the sticky bar (nearest positioned ancestor), aligned with
     the content column — anchoring to the button ran off-screen either way */
  .secpanel { position: absolute; top: calc(100% + 1px); z-index: 30;
              left: calc((100% - min(100%, 1080px)) / 2 + 24px);
              background: var(--card); border: 1px solid var(--line);
              border-radius: 2px; padding: 8px 12px 10px;
              min-width: min(620px, calc(100vw - 48px));
              max-width: calc(100vw - 48px);
              max-height: 70vh; overflow: auto; }
  .secrow { display: flex; align-items: baseline; gap: 10px; padding: 4px 0;
            border-top: 1px dotted #ececea; flex-wrap: wrap; }
  .secrow:first-child { border-top: 0; }
  .secrow .sec-title { flex: 0 0 210px; color: var(--ink);
                       text-decoration: none; font-weight: 600;
                       font-size: 0.85rem; }
  .secrow .sec-title:hover { color: var(--accent); }
  .secrow .sec-stat { flex: 1; color: var(--muted); font-size: 0.78rem;
                      white-space: nowrap; }
  .chips { display: inline-flex; gap: 4px; }
  .chip { display: inline-block; width: 22px; text-align: center;
          border: 1px dashed var(--line); border-radius: 2px;
          font-size: 0.72rem; line-height: 1.5; text-decoration: none;
          color: var(--muted); font-family: "JetBrains Mono", Consolas,
          monospace; }
  .chip.s2 { border: 1px solid var(--ok); color: var(--ok);
             background: #edf7ef; font-weight: 700; }
  .chip.s1 { border: 1px solid var(--accent); color: var(--accent);
             background: #fdf3e7; font-weight: 700; }
  .chip.s0 { border: 1px solid var(--bad); color: var(--bad);
             background: #fbeeee; font-weight: 700; }
  .chip.sna { border: 1px solid var(--line); color: var(--muted);
              background: #f1f1ef; text-decoration: line-through; }
  .chip-key { margin-top: 6px; color: var(--muted); font-size: 0.75rem; }
  .chip-key .chip { pointer-events: none; margin-right: 2px; }
  .next-btn { background: none; border: 1px solid var(--line);
              border-radius: 2px; padding: 2px 10px; font: inherit;
              font-size: 0.82rem; cursor: pointer; color: var(--ink); }
  .next-btn:hover { border-color: var(--accent); color: var(--accent); }

  .section-note { margin: 2px 0 8px; }
  .section-note label { display: block; font-size: 0.78rem; font-weight: 600;
                        color: var(--muted); text-transform: uppercase;
                        letter-spacing: 0.05em; margin-bottom: 2px; }
  .section-note textarea { width: 100%; border: 1px solid var(--line);
                           border-radius: 2px; padding: 5px 8px; font: inherit;
                           font-size: 0.85rem; background: var(--card);
                           resize: vertical; }

  .summary-grid { display: flex; gap: 28px; align-items: flex-start;
                  flex-wrap: wrap; margin: 12px 0 4px; }
  .sumtable { border-collapse: collapse; font-size: 0.86rem;
              background: var(--card); border: 1px solid var(--line); }
  .sumtable th { text-align: left; padding: 4px 12px; font-size: 0.72rem;
                 text-transform: uppercase; letter-spacing: 0.05em;
                 color: var(--muted); border-bottom: 1px solid var(--line); }
  .sumtable td { padding: 3px 12px; border-bottom: 1px dotted #ececea; }
  .sumtable th.num, .sumtable td.num { text-align: right; }
  .sumtable tfoot td { border-top: 1px solid var(--ink); border-bottom: 0;
                       font-weight: 700; }
  .sumtable a { color: var(--ink); text-decoration: none; }
  .sumtable a:hover { color: var(--accent); }
  .sum-note { color: var(--muted); font-size: 0.8rem; margin-top: 6px;
              max-width: 460px; }
  .radar-box { flex: 0 0 auto; }
  .radar-box svg { display: block; }
  .radar-legend { font-size: 0.78rem; color: var(--muted); margin-top: 2px; }
  .radar-legend .swatch { display: inline-block; width: 18px; height: 0;
                          border-top: 2px solid var(--accent);
                          vertical-align: 3px; margin-right: 5px; }
  .radar-legend .swatch.est { border-top-style: dashed;
                              border-top-color: var(--unknown); }

  .estimate { margin-top: 6px; padding: 5px 8px; font-size: 0.82rem;
              border: 1px dashed var(--line); border-radius: 2px;
              background: #fdf6ec; }
  .estimate.none { background: transparent; color: var(--muted);
                   font-style: italic; }
  .est-badge { display: inline-block; border: 1px solid var(--accent);
               color: var(--accent); border-radius: 2px; font-size: 0.68rem;
               padding: 0 5px; margin-right: 6px; text-transform: uppercase;
               letter-spacing: 0.05em; }
  .estimate .n { font-weight: 700; }
  .estimate ul { margin: 2px 0 0; padding-left: 18px; color: #555; }
  .est-warn { color: var(--gate); font-size: 0.75rem; margin-top: 2px; }
  .use-est { float: right; background: none; border: 1px solid var(--accent);
             color: var(--accent); border-radius: 2px; padding: 1px 8px;
             font: inherit; font-size: 0.78rem; cursor: pointer; }
  .use-est:hover { background: var(--accent); color: #fff; }

  .dep-warn { color: var(--bad); font-size: 0.8rem; margin-top: 4px; }
  .gate-fail { color: var(--bad); font-weight: 700; }
  .gate-pass { color: var(--ok); font-weight: 600; }
  .grade { margin-top: 6px; padding-top: 5px; border-top: 1px solid var(--line);
           font-size: 0.85rem; display: flex; align-items: center; gap: 10px; }
  .grade label { cursor: pointer; white-space: nowrap; }
  .grade input[type="text"] { flex: 1; border: 1px solid var(--line);
                              border-radius: 2px; padding: 3px 6px;
                              font: inherit; font-size: 0.85rem; }
  .exportbar { position: sticky; bottom: 0; background: var(--card);
               border-top: 1px solid var(--line); padding: 8px 0;
               margin-top: 28px; }
  .exportbar button { background: var(--accent); color: #fff; border: 0;
                      border-radius: 2px; padding: 6px 14px; font: inherit;
                      cursor: pointer; }
  .exportbar button.next-btn { background: none; color: var(--ink);
                               border: 1px solid var(--line); padding: 5px 13px; }
  .exportbar button.next-btn:hover { border-color: var(--bad);
                                     color: var(--bad); }
  .exportbar .status { margin-left: 12px; color: var(--muted);
                       font-size: 0.85rem; }
  .error { color: var(--bad); }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>AI-Readiness Human Review</h1>
    <div class="meta">
      {{ p.rubric }} · generated {{ p.generated }}
      {%- if not p.network_checks %} · <strong>network checks disabled</strong>{% endif %}
    </div>
    <div style="margin-top:6px">
      <strong>{{ p.crate.name }}</strong>
      <span class="mono">{{ p.crate["@id"] }}</span>
      <span class="meta"> · {{ p.crate.identifier }} · published {{ p.crate.datePublished }}</span>
    </div>
    <div class="toplinks">
      {% for d in p.artifacts.datasheets %}
        <a href="{{ d | href }}">Datasheet — {{ d }}</a>
      {% endfor %}
    </div>
  </div>
</header>

<div class="summarybar">
  <div class="wrap">
    <span id="sum-progress">Graded 0 of {{ p.sections | map(attribute='criteria') | map('length') | sum }}</span>
    <span class="pct-bar"><span id="sum-fill" style="width:0%"></span></span>
    <span class="score" id="sum-score"></span>
    <details class="secmenu">
      <summary>By section</summary>
      <div class="secpanel">
        {% for s in p.sections %}
        <div class="secrow">
          <a class="sec-title" href="#sec{{ s.number }}">{{ s.number }}. {{ s.title }}{% if s.gating %} *{% endif %}</a>
          <span class="chips">
            {%- for c in s.criteria -%}
            <a class="chip" data-chip="{{ c.id }}"
               href="#c{{ c.id | replace('.', '-') }}"
               title="{{ c.id }} {{ c.name }} — ungraded">{{ c.id.split('.')[1] }}</a>
            {%- endfor -%}
          </span>
          <span class="sec-stat" data-secstat="{{ s.number }}"></span>
        </div>
        {% endfor %}
        <div class="chip-key">
          <span class="chip s2">2</span><span class="chip s1">1</span
          ><span class="chip s0">0</span><span class="chip sna">a</span
          ><span class="chip">b</span> score chips — hollow = not yet graded;
          click any chip to jump to that criterion. * = gating section.
        </div>
      </div>
    </details>
    <button class="next-btn" id="next-ungraded" type="button">Next ungraded ↓</button>
  </div>
</div>

<div class="wrap">

  <nav class="toc">
    {% for s in p.sections %}
      <a href="#sec{{ s.number }}">{{ s.number }}. {{ s.title }}{% if s.gating %} *{% endif %}</a>
    {% endfor %}
  </nav>

  <div class="inventory">
    <strong>Crate inventory</strong> — {{ "{:,}".format(p.inventory.entities) }} entities
    ({% for t, n in p.inventory.by_type | dictsort(false, 'value') | reverse %}{{ t }}: {{ "{:,}".format(n) }}{% if not loop.last %}, {% endif %}{% endfor %})
    <table>
      <tr>
        <th>Sub-crate</th>
        <th>Location</th>
        <th class="num">Entities</th>
        <th>Links</th>
      </tr>
      {% for s in p.inventory.sub_crates %}
      <tr>
        <td>{{ s.name | truncate(70) }}</td>
        <td class="mono" style="font-size:0.78rem">{{ s.dir }}/</td>
        <td class="num">{{ "{:,}".format(s.entities) }}</td>
        <td>
          {% for g in s.prov_graphs %}<a href="{{ g | href }}">evidence graph</a> {% endfor %}
          {% if s.preview %}<a href="{{ s.preview | href }}">preview</a>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  {% for s in p.sections %}
  <h2 id="sec{{ s.number }}"><span>{{ s.number }}. {{ s.title }}
    {%- if s.gating %}<span class="badge">Gating</span>{% endif %}</span>
    <span class="axis-score" data-section="{{ s.number }}"
      ><span class="ax-progress"></span><span class="ax-pts"></span
      ><span class="ax-na"></span></span>
  </h2>

    {% for c in s.criteria %}
    <div class="criterion" id="c{{ c.id | replace('.', '-') }}">
      <h3>{{ c.id }} {{ c.name }}</h3>
      {% if c.gate_min %}<span class="badge">Gate: must score {{ "2" if c.gate_min == 2 else "above 0" }}</span>
      {%- elif c.gating %}<span class="badge">Gating</span>{% endif %}
      {% if c.depends_on %}<span class="badge">≤ {{ c.depends_on }}</span>{% endif %}
      <div class="practice">{{ c.practice }}</div>
      <details class="questions" open>
        <summary>Questions ({{ c.questions | length }})</summary>
        <ul>{% for q in c.questions %}<li>{{ q }}</li>{% endfor %}</ul>
      </details>

      <div class="scores">
        {% for score in ["2", "1", "0"] if score in c.scoring %}
        <div><span class="n">{{ score }}</span>{{ c.scoring[score] }}</div>
        {% endfor %}
      </div>
      {% if c.notes %}<div class="rubric-note">{{ c.notes }}</div>{% endif %}
      {% if c.gating_note %}<div class="rubric-note">{{ c.gating_note }}</div>{% endif %}

      <div class="evidence">
        {% if c.error %}<div class="error">extraction failed: {{ c.error }}</div>{% endif %}
        {% for item in c.evidence %}
        <div class="item{% if item.sub %} sub{% endif %}">
          <div class="label">{{ item.label }}</div>
          {#- every branch below is whitespace-controlled: any stray template
              newline/indent inside .value shows up as visible spacing -#}
          <div class="value">
            {%- if item.kind == "bool" -%}
              {%- if item.value is true -%}<span class="yes">✓ Yes</span>
              {%- elif item.value is false -%}<span class="no">✗ No</span>
              {%- else -%}<span class="na">— not checked</span>{%- endif -%}
            {%- elif item.kind == "count" -%}
              <strong>{{ "{:,}".format(item.value) }}</strong>
              {%- if item.of is defined %} of {{ "{:,}".format(item.of) }}{% endif -%}
            {%- elif item.kind == "percent" -%}
              {%- if item.value is not none -%}
                <span class="pct-bar"><span style="width:{{ [item.value, 100] | min }}%"></span></span> <strong>{{ item.value }}%</strong> <span class="meta">({{ "{:,}".format(item.n) }} of {{ "{:,}".format(item.total) }})</span>
              {%- else -%}<span class="na">— no denominator</span>{%- endif -%}
            {%- elif item.kind == "link" -%}
              {%- if item.value -%}<a href="{{ item.value | href }}">{{ item.text | default(item.value, true) }}</a>
              {%- else -%}<span class="na">none</span>{%- endif -%}
            {%- elif item.kind == "links" -%}
              {%- if item.value -%}
                <ul class="plain">
                {%- for l in item.value -%}
                  <li>{% if l.href %}<a href="{{ l.href | href }}">{{ l.text | default(l.href, true) }}</a>{% else %}{{ l.text | linkify }}{% endif %}</li>
                {%- endfor -%}
                </ul>
              {%- else -%}<span class="na">none</span>{%- endif -%}
            {%- elif item.kind == "list" -%}
              {%- if item.value -%}
                {%- if item.value | length == 1 -%}{{ item.value[0] | linkify }}
                {%- else -%}<ul class="plain">{% for v in item.value %}<li>{{ v | linkify }}</li>{% endfor %}</ul>{%- endif -%}
              {%- else -%}<span class="na">none</span>{%- endif -%}
            {%- elif item.kind == "entity" -%}
              {%- if item.value -%}
                <details class="entity"><summary>{{ item.value.name | default(item.value["@id"], true) | default("view entity", true) }}</summary><pre>{{ item.value | tojson_pretty | linkify }}</pre></details>
              {%- else -%}<span class="na">none found</span>{%- endif -%}
            {%- else -%}
              {%- if item.value -%}
                {%- if item.value | length > 260 -%}
                  <details class="longtext"><summary><span class="head">{{ item.value | truncate(240, False, '…') | linkify }}</span> <span class="more">[{{ "{:,}".format(item.value | length) }} chars — expand]</span></summary><span class="pre">{{ item.value | linkify }}</span></details>
                {%- else -%}<span class="pre">{{ item.value | linkify }}</span>{%- endif -%}
              {%- else -%}<span class="na">not provided</span>{%- endif -%}
            {%- endif -%}
            {%- if item.detail %} <span class="detail">{{ item.detail | linkify }}</span>{% endif -%}
          </div>
        </div>
        {% endfor %}
      </div>

      {% if c.estimate %}
      <div class="estimate">
        <button class="use-est" data-criterion="{{ c.id }}"
                data-score="{{ c.estimate.score }}">use as starting point</button>
        <span class="est-badge">Automated estimate</span>
        <span class="n">{{ c.estimate.score }}</span>
        <ul>{% for b in c.estimate.basis %}<li>{{ b | linkify }}</li>{% endfor %}</ul>
        <div class="est-warn">⚠ Estimated from the extracted evidence only —
          it may be wrong. Review the evidence above before accepting.</div>
      </div>
      {% else %}
      <div class="estimate none">No automated estimate — this criterion needs
        human judgment.</div>
      {% endif %}

      <div class="grade" data-criterion="{{ c.id }}"{% if c.estimate %} data-estimate="{{ c.estimate.score }}"{% endif %}{% if c.gate_min %} data-gate-min="{{ c.gate_min }}"{% endif %}{% if c.depends_on %} data-depends-on="{{ c.depends_on }}"{% endif %}>
        <strong>Your score:</strong>
        {% for opt in ["2", "1", "0", "N/A"] %}
          <label><input type="radio" name="score-{{ c.id }}" value="{{ opt }}"> {{ opt }}</label>
        {% endfor %}
        <input type="text" placeholder="reviewer notes…">
      </div>
      {% if c.depends_on %}
      <div class="dep-warn" data-depwarn="{{ c.id }}" hidden>⚠ Dependency rule
        {{ c.id }} ≤ {{ c.depends_on }}: this score exceeds {{ c.depends_on }}'s
        score, which the rubric does not allow — the aggregate will cap it.</div>
      {% endif %}
    </div>
    {% endfor %}

    <div class="section-note">
      <label for="secnote-{{ s.number }}">Section {{ s.number }} comments</label>
      <textarea id="secnote-{{ s.number }}" data-secnote="{{ s.number }}" rows="2"
        placeholder="Context behind this section's scores — caveats, research-question dependence, evidence the extractor missed…"></textarea>
    </div>
  {% endfor %}

  <h2 id="summary"><span>Score summary</span></h2>
  <div class="summary-grid">
    <div>
      <table class="sumtable">
        <thead>
          <tr><th>Section</th><th class="num">Graded</th>
              <th class="num">Points</th><th class="num">%</th>
              <th class="num">N/A</th><th>Gate</th></tr>
        </thead>
        <tbody>
          {% for s in p.sections %}
          <tr data-sumrow="{{ s.number }}">
            <td><a href="#sec{{ s.number }}">{{ s.number }}. {{ s.title }}</a>
                {%- if s.gating or s.criteria | selectattr('gate_min', 'defined') | list %} <span class="badge">Gating</span>{% endif %}</td>
            <td class="num sr-graded"></td><td class="num sr-pts"></td>
            <td class="num sr-pct"></td><td class="num sr-na"></td>
            <td class="sr-gate"></td>
          </tr>
          {% endfor %}
        </tbody>
        <tfoot>
          <tr data-sumrow="total">
            <td>Total</td>
            <td class="num sr-graded"></td><td class="num sr-pts"></td>
            <td class="num sr-pct"></td><td class="num sr-na"></td>
            <td class="sr-gate"></td>
          </tr>
        </tfoot>
      </table>
      <div class="sum-note">Points and percentages cover graded criteria only;
        N/A answers are excluded from the denominator (N/A is not permitted on
        a gating criterion). The <strong>overall AI-readiness score</strong> is
        the unweighted average of the section percentages. Gate thresholds:
        0.a must score 2; every other FAIRness, Provenance, and Ethics
        criterion, and 2.c (Standards), must score above 0 — a gate failure
        marks the section and the overall result "Gating FAIL" (the score is
        still computed). Dependency rules 1.b ≤ 1.a and 6.a ≤ 2.c are checked
        as you grade. Sections not yet graded plot at 0 on the chart.</div>
      <div class="sum-note" id="overall-line" style="margin-top:8px"></div>
    </div>
    <div class="radar-box">
      <svg id="radar" width="320" height="320" viewBox="0 0 320 320"
           role="img" aria-label="Per-section score radar chart"></svg>
      <div class="radar-legend">
        <span class="swatch"></span>your scores &nbsp;
        <span class="swatch est"></span>unverified automated estimates
      </div>
    </div>
  </div>

  <div class="exportbar">
    <button id="save-html" type="button"
            title="Download this page with every score, note and section comment written into it — send that file to share or continue the review elsewhere">Save review as HTML</button>
    <button id="export">Copy scores as JSON</button>
    <button id="reset" class="next-btn" type="button">Reset all scores</button>
    <span class="status" id="export-status"></span>
  </div>
</div>

{# scores embedded by "Save review as HTML"; empty in a freshly generated page.
   restoreState() prefers whichever of this block and the browser copy is newer. #}
<script type="application/json" id="review-state">{}</script>

<script>
var grades = document.querySelectorAll('.grade');
var secNotes = document.querySelectorAll('textarea[data-secnote]');

// per-axis rollups, keyed by the criterion id prefix ("0.a" -> "0") — the same
// grouping the machine grader uses (rubric_eval._aggregate)
var axes = {};
document.querySelectorAll('.axis-score').forEach(function (el) {
  axes[el.dataset.section] = {
    el: el,
    stat: document.querySelector('[data-secstat="' + el.dataset.section + '"]'),
    row: document.querySelector('[data-sumrow="' + el.dataset.section + '"]'),
    total: 0, estPts: 0, estMax: 0
  };
});
var axisOrder = Object.keys(axes);  // template order
var chips = {};
document.querySelectorAll('.chip[data-chip]').forEach(function (el) {
  chips[el.dataset.chip] = el;
});
grades.forEach(function (g) {
  var a = axes[g.dataset.criterion.split('.')[0]];
  if (!a) return;
  a.total += 1;
  if (g.dataset.gateMin) a.gatedTotal = (a.gatedTotal || 0) + 1;
  var e = g.dataset.estimate;
  if (e !== undefined && e !== 'N/A') { a.estPts += +e; a.estMax += 2; }
});

// v1.8 dependency rules, read off the criterion markup (1.b ≤ 1.a, 6.a ≤ 2.c)
var deps = {};
grades.forEach(function (g) {
  if (g.dataset.dependsOn) deps[g.dataset.criterion] = g.dataset.dependsOn;
});

function scoreOf(id) {
  var g = document.querySelector('.grade[data-criterion="' + id + '"]');
  var checked = g && g.querySelector('input:checked');
  return checked ? checked.value : null;
}

function fillRow(row, r) {
  if (!row) return;
  row.querySelector('.sr-graded').textContent = r.graded + ' / ' + r.total;
  row.querySelector('.sr-pts').textContent =
    r.max ? r.pts + ' / ' + r.max : '—';
  row.querySelector('.sr-pct').textContent =
    r.max ? Math.round(100 * r.pts / r.max) + '%' : '—';
  row.querySelector('.sr-na').textContent = r.na || '';
  var gate = row.querySelector('.sr-gate');
  if (gate) {
    if (!r.gatedTotal) { gate.textContent = '—'; gate.className = 'sr-gate'; }
    else if (r.gateFail && r.gateFail.length) {
      gate.textContent = 'FAIL (' + r.gateFail.join('; ') + ')';
      gate.className = 'sr-gate gate-fail';
    } else if (r.gatePending) {
      gate.textContent = r.gatePending + ' gated left';
      gate.className = 'sr-gate';
    } else {
      gate.textContent = 'pass';
      gate.className = 'sr-gate gate-pass';
    }
  }
}

// N/A counts as graded but leaves the axis denominator alone, matching the
// global bar
function renderAxis(a) {
  a.el.querySelector('.ax-progress').textContent =
    a.graded + ' of ' + a.total + ' graded';
  a.el.querySelector('.ax-pts').textContent = a.max
    ? ' · ' + a.pts + ' / ' + a.max + ' pts (' +
      Math.round(100 * a.pts / a.max) + '%)'
    : '';
  a.el.querySelector('.ax-na').textContent = a.na ? ' · ' + a.na + ' N/A' : '';
  a.el.classList.toggle('complete', a.graded === a.total);
  if (a.stat) {
    var gateNote = (a.gateFail && a.gateFail.length) ? ' · GATE FAIL' :
      (a.gatedTotal && !a.gatePending && a.graded ? ' · gate ok' : '');
    a.stat.textContent = ((a.total - a.graded)
      ? (a.total - a.graded) + ' left' +
        (a.max ? ' · ' + a.pts + '/' + a.max + ' pts so far' : '')
      : 'done · ' + a.pts + ' / ' + a.max + ' pts' +
        (a.na ? ' · ' + a.na + ' N/A' : '')) + gateNote;
  }
  fillRow(a.row, a);
}

function renderChip(g, checked) {
  var chip = chips[g.dataset.criterion];
  if (!chip) return;
  chip.className = 'chip' + (checked
    ? ' ' + (checked.value === 'N/A' ? 'sna' : 's' + checked.value) : '');
  chip.title = chip.title.replace(/ — [^—]*$/, '') +
    ' — ' + (checked ? 'scored ' + checked.value : 'ungraded');
}

// ---- radar ------------------------------------------------------------
var RADAR = { cx: 160, cy: 160, r: 108 };

function radarPoint(i, frac) {
  var ang = -Math.PI / 2 + (2 * Math.PI * i) / axisOrder.length;
  return (RADAR.cx + RADAR.r * frac * Math.cos(ang)).toFixed(1) + ',' +
         (RADAR.cy + RADAR.r * frac * Math.sin(ang)).toFixed(1);
}

function radarPoly(fracs, attrs) {
  return '<polygon points="' +
    fracs.map(function (f, i) { return radarPoint(i, f); }).join(' ') +
    '" ' + attrs + '/>';
}

function drawRadar() {
  var svg = ['<g>'];
  [0.25, 0.5, 0.75, 1].forEach(function (ring) {
    svg.push(radarPoly(axisOrder.map(function () { return ring; }),
      'fill="none" stroke="#d9d9d9" stroke-width="' +
      (ring === 1 ? 1.2 : 0.6) + '"'));
  });
  axisOrder.forEach(function (k, i) {
    svg.push('<line x1="' + RADAR.cx + '" y1="' + RADAR.cy + '" ' +
      'x2="' + radarPoint(i, 1).replace(',', '" y2="') +
      '" stroke="#ececea" stroke-width="0.6"/>');
    var pos = radarPoint(i, 1.13).split(',');
    svg.push('<text x="' + pos[0] + '" y="' + pos[1] + '" ' +
      'text-anchor="middle" dominant-baseline="middle" ' +
      'font-size="12" font-weight="600" fill="#6b6b6b">' + k + '</text>');
  });
  var est = axisOrder.map(function (k) {
    return axes[k].estMax ? axes[k].estPts / axes[k].estMax : 0;
  });
  if (est.some(function (f) { return f > 0; })) {
    svg.push(radarPoly(est, 'fill="none" stroke="#6b6b6b" ' +
      'stroke-width="1.4" stroke-dasharray="5 4"'));
  }
  var human = axisOrder.map(function (k) {
    return axes[k].max ? axes[k].pts / axes[k].max : 0;
  });
  if (human.some(function (f) { return f > 0; })) {
    svg.push(radarPoly(human, 'fill="rgba(180,83,9,0.12)" ' +
      'stroke="#b45309" stroke-width="1.8"'));
    human.forEach(function (f, i) {
      if (!axes[axisOrder[i]].max) return;
      var pos = radarPoint(i, f).split(',');
      svg.push('<circle cx="' + pos[0] + '" cy="' + pos[1] +
        '" r="2.6" fill="#b45309"/>');
    });
  }
  svg.push('</g>');
  document.getElementById('radar').innerHTML = svg.join('');
}

function updateSummary() {
  var graded = 0, pts = 0, max = 0, na = 0;
  Object.keys(axes).forEach(function (k) {
    var a = axes[k];
    a.graded = 0; a.pts = 0; a.max = 0; a.na = 0;
    a.gateFail = []; a.gatePending = 0;
  });
  grades.forEach(function (g) {
    var checked = g.querySelector('input:checked');
    renderChip(g, checked);
    var a = axes[g.dataset.criterion.split('.')[0]];
    var min = g.dataset.gateMin;
    if (!checked) {
      if (min && a) a.gatePending += 1;
      return;
    }
    graded += 1;
    if (a) a.graded += 1;
    if (min && a) {
      if (checked.value === 'N/A') {
        a.gateFail.push(g.dataset.criterion + ' is N/A (not permitted on a gating criterion)');
      } else if (+checked.value < +min) {
        a.gateFail.push(g.dataset.criterion + ' scored ' + checked.value +
          ' (needs ' + (min === '2' ? '2' : '> 0') + ')');
      }
    }
    if (checked.value === 'N/A') { na += 1; if (a) a.na += 1; return; }
    pts += +checked.value; max += 2;
    if (a) { a.pts += +checked.value; a.max += 2; }
  });
  // dependency warnings (1.b ≤ 1.a, 6.a ≤ 2.c)
  var depViolations = [];
  Object.keys(deps).forEach(function (id) {
    var warn = document.querySelector('[data-depwarn="' + id + '"]');
    var s = scoreOf(id), p = scoreOf(deps[id]);
    var bad = s !== null && p !== null && s !== 'N/A' && p !== 'N/A' && +s > +p;
    if (warn) warn.hidden = !bad;
    if (bad) depViolations.push(id + ' > ' + deps[id]);
  });
  // v1.8 overall score: unweighted average of section percentages + gates
  var gateFailures = [], gatePending = 0, sectionPcts = [];
  Object.keys(axes).forEach(function (k) {
    var a = axes[k];
    gateFailures = gateFailures.concat(a.gateFail);
    gatePending += a.gatePending;
    if (a.max) sectionPcts.push(100 * a.pts / a.max);
  });
  var overall = sectionPcts.length
    ? Math.round(10 * sectionPcts.reduce(function (x, y) { return x + y; }, 0)
        / sectionPcts.length) / 10
    : null;
  var gateLabel = gateFailures.length ? 'Gating FAIL'
    : (gatePending ? gatePending + ' gated criteria left' : 'gates passed');
  document.getElementById('sum-progress').textContent =
    'Graded ' + graded + ' of ' + grades.length;
  document.getElementById('sum-fill').style.width =
    (100 * graded / grades.length) + '%';
  document.getElementById('sum-score').innerHTML = (max
    ? pts + ' / ' + max + ' pts · overall ' + overall + '%' : '') +
    (gateFailures.length
      ? ' · <span class="gate-fail">Gating FAIL</span>' : '') +
    (depViolations.length
      ? ' · <span class="gate-fail">⚠ ' + depViolations.join(', ') + '</span>'
      : '');
  var overallLine = document.getElementById('overall-line');
  if (overallLine) {
    overallLine.innerHTML = overall === null ? '' :
      '<strong>Overall AI-readiness score: ' + overall + '%</strong>' +
      ' (unweighted average of section percentages on graded criteria) · ' +
      (gateFailures.length
        ? '<span class="gate-fail">Gating FAIL — ' +
          gateFailures.join('; ') + '</span>'
        : (gatePending
          ? gatePending + ' gated criteria not yet graded'
          : '<span class="gate-pass">all gates passed</span>')) +
      (depViolations.length
        ? ' · <span class="gate-fail">dependency rule violated: ' +
          depViolations.join(', ') + '</span>'
        : '');
  }
  Object.keys(axes).forEach(function (k) { renderAxis(axes[k]); });
  fillRow(document.querySelector('[data-sumrow="total"]'),
    { graded: graded, total: grades.length, pts: pts, max: max, na: na,
      gatedTotal: gateFailures.length + gatePending ||
        document.querySelectorAll('.grade[data-gate-min]').length,
      gateFail: gateFailures, gatePending: gatePending });
  drawRadar();
  window.__reviewGating = { failures: gateFailures, pending: gatePending,
                            overall: overall, dep_violations: depViolations };
}

// ---- autosave: browser storage + state embedded in the file -------------
// A freshly generated page keys browser storage by crate id. A page written by
// "Save review as HTML" carries a review id as well, so a copy someone sent
// you never collides with your own review of the same crate.
var stateEl = document.getElementById('review-state');
var embedded = {};
try { embedded = JSON.parse(stateEl.textContent || '{}') || {}; }
catch (err) { embedded = {}; }
var REVIEW_ID = embedded.review_id || null;
var STORE_KEY = 'ai-ready-review:' + {{ p.crate["@id"] | tojson }} +
  (REVIEW_ID ? ':' + REVIEW_ID : '');

function collectState() {
  var state = { scores: {}, section_notes: {},
                saved_at: new Date().toISOString() };
  if (REVIEW_ID) state.review_id = REVIEW_ID;
  grades.forEach(function (g) {
    var checked = g.querySelector('input:checked');
    var notes = g.querySelector('input[type=text]').value;
    if (checked || notes) {
      state.scores[g.dataset.criterion] =
        { score: checked ? checked.value : null, notes: notes || null };
    }
  });
  secNotes.forEach(function (t) {
    if (t.value) state.section_notes[t.dataset.secnote] = t.value;
  });
  return state;
}

function saveState() {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(collectState())); }
  catch (err) { /* private mode / quota — grading still works, just unsaved */ }
}

function applyState(state) {
  var n = 0;
  grades.forEach(function (g) {
    var saved = (state.scores || {})[g.dataset.criterion];
    if (!saved) return;
    if (saved.score) {
      var radio = g.querySelector('input[value="' + saved.score + '"]');
      if (radio) { radio.checked = true; n += 1; }
    }
    if (saved.notes) g.querySelector('input[type=text]').value = saved.notes;
  });
  secNotes.forEach(function (t) {
    var v = (state.section_notes || {})[t.dataset.secnote];
    if (v) t.value = v;
  });
  return n;
}

function restoreState() {
  var local = null;
  try {
    var raw = localStorage.getItem(STORE_KEY);
    if (raw) local = JSON.parse(raw);
  } catch (err) { local = null; }
  var hasEmbedded = embedded.scores && Object.keys(embedded.scores).length;
  // newer wins; a browser copy with no timestamp predates embedded saves
  var useLocal = local && (!hasEmbedded ||
    (local.saved_at && embedded.saved_at && local.saved_at >= embedded.saved_at));
  var state = useLocal ? local : (hasEmbedded ? embedded : null);
  if (!state) return;
  var n = applyState(state);
  if (n) {
    document.getElementById('export-status').textContent = 'restored ' + n +
      ' saved scores from ' + (useLocal ? 'this browser' : 'this file') +
      (state.saved_at ? ' (saved ' + state.saved_at.replace('T', ' ')
        .replace(/\.\d+Z$/, ' UTC') + ')' : '');
  }
}

function randomId() {
  var s = '', chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
  for (var i = 0; i < 10; i++) s += chars[Math.floor(Math.random() * 36)];
  return s;
}

// Serialize the whole page with the current state written into #review-state
// and hand it to the browser as a download. Everything the scripts derive
// (summary bar, chips, radar) is recomputed on load, so the snapshot only has
// to carry the scores and notes.
function saveAsHtml() {
  if (!REVIEW_ID) {
    REVIEW_ID = randomId();
    STORE_KEY += ':' + REVIEW_ID;
  }
  var state = collectState();
  stateEl.textContent = JSON.stringify(state).replace(/</g, '\\u003c');
  try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); }
  catch (err) { }
  var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  var name = 'ai-ready-review.html';
  try {
    var last = decodeURIComponent(location.pathname.split('/').pop());
    if (/\.html?$/i.test(last)) name = last;
  } catch (err) { }
  var blob = new Blob([html], { type: 'text/html' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  var n = Object.keys(state.scores).length;
  document.getElementById('export-status').textContent =
    'saved ' + name + ' with ' + n + ' scored criteria — send that file to share the review';
}

document.getElementById('save-html').addEventListener('click', saveAsHtml);

var saveTimer;
document.addEventListener('input', function (e) {
  if (e.target.type === 'text' || e.target.tagName === 'TEXTAREA') {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(saveState, 400);
  }
});
document.addEventListener('change', function (e) {
  if (e.target.type === 'radio') { updateSummary(); saveState(); }
});

document.querySelectorAll('.use-est').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var radio = document.querySelector(
      'input[name="score-' + btn.dataset.criterion + '"][value="' +
      btn.dataset.score + '"]');
    if (radio) { radio.checked = true; updateSummary(); saveState(); }
  });
});

document.getElementById('next-ungraded').addEventListener('click', function () {
  for (var i = 0; i < grades.length; i++) {
    if (!grades[i].querySelector('input:checked')) {
      grades[i].closest('.criterion').scrollIntoView(
        { behavior: 'smooth', block: 'center' });
      return;
    }
  }
  document.getElementById('summary').scrollIntoView({ behavior: 'smooth' });
});

document.getElementById('reset').addEventListener('click', function () {
  if (!confirm('Clear every score, note, and section comment?')) return;
  grades.forEach(function (g) {
    var checked = g.querySelector('input:checked');
    if (checked) checked.checked = false;
    g.querySelector('input[type=text]').value = '';
  });
  secNotes.forEach(function (t) { t.value = ''; });
  saveState();  // an empty, newer state also outranks scores embedded in the file
  document.getElementById('export-status').textContent = 'cleared';
  updateSummary();
});

restoreState();
updateSummary();

document.getElementById('export').addEventListener('click', function () {
  var out = { crate: {{ p.crate["@id"] | tojson }}, scores: {},
              section_notes: {}, sections: {} };
  grades.forEach(function (g) {
    var id = g.dataset.criterion;
    var checked = g.querySelector('input:checked');
    out.scores[id] = {
      score: checked ? checked.value : null,
      notes: g.querySelector('input[type=text]').value || null,
      estimate: g.dataset.estimate !== undefined ? g.dataset.estimate : null
    };
  });
  secNotes.forEach(function (t) {
    out.section_notes[t.dataset.secnote] = t.value || null;
  });
  Object.keys(axes).forEach(function (k) {
    var a = axes[k];
    out.sections[k] = { graded: a.graded, total: a.total, points: a.pts,
                        max_points: a.max, na: a.na,
                        percentage: a.max
                          ? Math.round(1000 * a.pts / a.max) / 10 : null,
                        gate_failures: a.gateFail || [] };
  });
  var gating = window.__reviewGating || {};
  out.overall_score = gating.overall !== undefined ? gating.overall : null;
  out.gating = {
    failures: gating.failures || [],
    pending: gating.pending || 0,
    label: (gating.failures && gating.failures.length) ? 'Gating FAIL'
      : (gating.pending ? 'gates not fully scored' : 'gates passed')
  };
  out.dependency_violations = gating.dep_violations || [];
  var text = JSON.stringify(out, null, 2);
  navigator.clipboard.writeText(text).then(function () {
    document.getElementById('export-status').textContent =
      'copied ' + Object.keys(out.scores).length + ' criteria to clipboard';
  }, function () {
    document.getElementById('export-status').textContent =
      'clipboard blocked — JSON logged to console';
    console.log(text);
  });
});
</script>

</body>
</html>
